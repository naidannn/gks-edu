# =========================================================
#  Database — Supabase (default for development)
# =========================================================
# Transaction-mode pooler (IPv4-friendly). This is what the app connects with.
# `pgbouncer=true` tells Prisma to disable prepared statements.
DATABASE_URL="postgresql://postgres.akeoiltilmxyynhlrfxn:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Session-mode pooler. Prisma Migrate / db push / studio use this one.
DIRECT_URL="postgresql://postgres.akeoiltilmxyynhlrfxn:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# --- Local Postgres 17 + pgvector instead of Supabase? ---
# Run `pnpm db:up:local`, then swap in:
# DATABASE_URL="postgresql://gks:gks_dev_password@localhost:5432/gks_edu?schema=public"
# DIRECT_URL="postgresql://gks:gks_dev_password@localhost:5432/gks_edu?schema=public"

# Only read by docker compose for the optional local Postgres container.
POSTGRES_USER=gks
POSTGRES_PASSWORD=gks_dev_password
POSTGRES_DB=gks_edu
POSTGRES_PORT=5432

# =========================================================
#  Redis (docker compose)
# =========================================================
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# =========================================================
#  API
# =========================================================
NODE_ENV=development
API_PORT=3001
API_PREFIX=api
CORS_ORIGIN=http://localhost:3000

JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-too-another-long-random-string
JWT_REFRESH_EXPIRES_IN=7d

# Dimension of the embedding vectors stored in pgvector.
EMBEDDING_DIMENSIONS=1536

# =========================================================
#  QPay v2 (1C-12). The live merchant only exists in production
#  (deploy/.env.production) and QPay issued no sandbox account, so
#  development keeps QPAY_MOCK=true and fakes invoice creation and
#  payment-check rather than minting real invoices against it.
# =========================================================
QPAY_MOCK=true
QPAY_BASE_URL="https://merchant.qpay.mn/v2"
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_INVOICE_CODE=
QPAY_CALLBACK_URL="http://localhost:3001/api/v1/payments/qpay/webhook"

# =========================================================
#  Google sign-in ("Google-ээр нэвтрэх")
#  One OAuth 2.0 *Web application* client from console.cloud.google.com →
#  APIs & Services → Credentials. The API verifies every ID token against this
#  id, so GOOGLE_CLIENT_ID and NUXT_PUBLIC_GOOGLE_CLIENT_ID must be the same
#  value. Authorised JavaScript origins must list the web origin
#  (http://localhost:3000 in development, https://gksedu.mn in production); the
#  popup flow needs no redirect URI and no client secret.
#  Unset = the button does not render and POST /auth/google returns 503.
# =========================================================
# GOOGLE_CLIENT_ID=

# =========================================================
#  Currency rates (1E-07) — the MNT-per-KRW rate a school invoice is priced at.
#  Mongolbank publishes the rate but exposes no documented JSON API, so the
#  default is a public mirror of it (ARCHITECTURE.md §18 question 11). The
#  fallback is used only while the fx_rates table is still empty.
# =========================================================
# FX_RATES_URL="https://monxansh.appspot.com/xansh.json?currency=KRW"
# FX_FALLBACK_KRW_RATE=2.65

# =========================================================
#  Notifications (1G-01…1G-04)
#  With RESEND_API_KEY unset, EmailService logs the message instead of sending
#  it — development and tests never post real mail. The SMS gateway itself is
#  still an open business question (ARCHITECTURE.md §18 question 10), so
#  SmsService logs too; the daily ceilings below apply regardless and cap the
#  bill once a real gateway is wired in.
#
#  The from-address's domain must be verified in Resend before anything sends —
#  gksedu.mn is. `pnpm email:preview` renders every mail to disk without
#  sending, which is the way to look at the design.
# =========================================================
# RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL="GKSedu <noreply@gksedu.mn>"
# Staff-facing fallback address for notifications with no assigned recipient.
# NOTIFICATION_STAFF_EMAIL=
# Reply-To on every outgoing mail. The from-address is a no-reply; without this
# a client who hits "Reply" writes into a void.
# NOTIFICATION_REPLY_TO=
# Base URL the {{link}} placeholders resolve against. It is also where the
# email header logo is loaded from (/img/brand/…), so in production it must be
# the public site, not localhost.
APP_PUBLIC_URL=http://localhost:3000

# =========================================================
#  Marketing mail — Brevo (1O)
#  The second rail. Resend above carries the mail a person is waiting for (a
#  login link, an OTP, "төлбөр баталгаажлаа"); Brevo carries the mail nobody
#  asked for today (newsletter, GKS campaign, university news, expo). Two
#  providers on purpose: one campaign into a stale list must not cost the
#  password-reset mail its deliverability.
#
#  With BREVO_API_KEY unset the campaign is written to the log instead of
#  being sent, exactly as with Resend — a dev machine can run a whole campaign
#  end to end without mailing anybody.
#
#  The sender address is verified inside Brevo, separately from Resend's
#  domain verification. BREVO_LIST_ID is the contact list subscribers are
#  synced into so the office can also build campaigns in Brevo's own designer;
#  unset (0) disables only that sync, not sending.
# =========================================================
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=mail@gksedu.mn
# BREVO_SENDER_NAME="GKS EDU GROUP"
# BREVO_REPLY_TO=
# BREVO_LIST_ID=
# How many recipients one queue pass mails before it yields. Lower it if Brevo
# starts rate-limiting; the run simply takes more passes.
# BREVO_BATCH_SIZE=50
SMS_DAILY_LIMIT_PER_USER=3
SMS_DAILY_LIMIT_GLOBAL=500

# --- Slack (staff channel) --------------------------------------------------
# A bot token (`xoxb-…`) with the `chat:write` scope, and the channel the office
# watches. The bot must be invited to that channel or Slack answers
# `not_in_channel`. With either variable unset the API logs the message instead
# of posting, so development never writes into the real channel.
# SLACK_BOT_TOKEN=
# SLACK_CHANNEL_ID=

# =========================================================
#  Gemini — intake-date research (1H-10)
#
#  The admin "Интернэтээс судлах" button asks Gemini, with Google Search
#  grounding, for one school's intake calendar. It only ever FILLS THE FORM —
#  a human reviews and saves. With no key set the service returns a mock
#  response so the screen is usable in dev, exactly like QPAY_MOCK.
# =========================================================
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# A grounded search runs 30-90s.
GEMINI_TIMEOUT_MS=120000
# Unset it defaults to true while GEMINI_API_KEY is empty.
GEMINI_MOCK=true
# Google Search grounding. Billed per search query, and an account without
# grounding quota answers every grounded call with a 429 — set this to false
# there and the model answers from memory instead, with every candidate marked
# LOW and carrying a "verify this" note for the reviewer.
GEMINI_SEARCH=true

# =========================================================
#  File storage (0-08)
#
#  local     — writes under apps/api/storage/. The dev default: no account
#              needed, and nothing leaves the machine.
#  s3        — production. A PRIVATE bucket: nothing is ever public-read, and
#              clients still reach files only through GET /files/:token.
#  supabase  — the earlier backend, kept so an existing bucket stays readable.
#
#  An unrecognised value fails at boot rather than quietly falling back to
#  local — a typo must not park client passports on the server's disk.
# =========================================================
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=storage
# STORAGE_SIGNING_SECRET=              # defaults to JWT_SECRET if unset

# --- s3 ---------------------------------------------------------------------
# S3_BUCKET is required when STORAGE_DRIVER=s3 (checked at boot).
# Keep the bucket in the same region as the API box (ap-southeast-1), or every
# download pays cross-region transfer.
# The key pair belongs to an IAM user scoped to this one bucket. Leave both
# unset to use the SDK's default chain instead (EC2 instance role, ~/.aws) —
# but note our production box is shared with ten other apps, so an instance
# role would hand them the bucket too.
# S3_BUCKET=gksedu-files
# AWS_REGION=ap-southeast-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_ENDPOINT=                         # only for MinIO/R2; empty for real AWS

# --- supabase ---------------------------------------------------------------
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=gks-edu-files

# =========================================================
#  Meta pixel + Conversions API (1A-38)
#
#  One dataset, written to from two sides: the browser pixel and the server.
#  META_PIXEL_ID and NUXT_PUBLIC_META_PIXEL_ID must be the same value, or the
#  two halves land in different datasets and nothing deduplicates.
#
#  The token is a system-user token from Events Manager → Settings. It is the
#  only secret here; the dataset id is public by design.
#
#  META_TEST_EVENT_CODE: set it to the code from Events Manager → Test events
#  while checking the setup, then clear it — events carrying a code show up in
#  that tool and are excluded from measurement.
# =========================================================
# META_PIXEL_ID=
# META_CAPI_ACCESS_TOKEN=
# NUXT_PUBLIC_META_PIXEL_ID=
# META_GRAPH_VERSION=v26.0
# META_TEST_EVENT_CODE=
# META_CAPI_TIMEOUT_MS=10000
# Forces the log-instead-of-send path even with a token present.
# META_CAPI_MOCK=false

# =========================================================
#  Web
# =========================================================
NUXT_PUBLIC_API_BASE=http://localhost:3001/api/v1
# GA4 measurement id (public by design). Unset = no analytics script is
# injected at all; production sets it in deploy/.env.production.
# NUXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# Same value as GOOGLE_CLIENT_ID above — it is public by design.
# NUXT_PUBLIC_GOOGLE_CLIENT_ID=

# =========================================================
#  University reference dataset (135 records + logos)
# =========================================================
# Source repo for `pnpm universities:import`. Not part of this workspace.
UNIVERSITIES_DATA_DIR="../korean-universities-data"
