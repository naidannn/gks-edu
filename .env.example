# =========================================================
#  Database — Supabase (default for development)
# =========================================================
# Transaction-mode pooler (IPv4-friendly). This is what the app connects with.
# `pgbouncer=true` tells Prisma to disable prepared statements.
DATABASE_URL="postgresql://postgres.akeoiltilmxyynhlrfxn:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Session-mode pooler. Prisma Migrate / db push / studio use this one.
DIRECT_URL="postgresql://postgres.akeoiltilmxyynhlrfxn:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# --- Local Postgres 17 + pgvector instead of Supabase? ---
# Run `pnpm db:up:local`, then swap in:
# DATABASE_URL="postgresql://gks:gks_dev_password@localhost:5432/gks_edu?schema=public"
# DIRECT_URL="postgresql://gks:gks_dev_password@localhost:5432/gks_edu?schema=public"

# Only read by docker compose for the optional local Postgres container.
POSTGRES_USER=gks
POSTGRES_PASSWORD=gks_dev_password
POSTGRES_DB=gks_edu
POSTGRES_PORT=5432

# =========================================================
#  Redis (docker compose)
# =========================================================
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# =========================================================
#  API
# =========================================================
NODE_ENV=development
API_PORT=3001
API_PREFIX=api
CORS_ORIGIN=http://localhost:3000

JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-too-another-long-random-string
JWT_REFRESH_EXPIRES_IN=7d

# Dimension of the embedding vectors stored in pgvector.
EMBEDDING_DIMENSIONS=1536

# =========================================================
#  Web
# =========================================================
NUXT_PUBLIC_API_BASE=http://localhost:3001/api/v1
