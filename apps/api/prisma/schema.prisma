// Prisma schema — PostgreSQL 17 with the pgvector extension.
//
// Prisma 7 keeps connection URLs out of this file; they live in
// `prisma.config.ts` (CLI) and in the driver adapter (`PrismaService`).
//
// `Unsupported("vector(1536)")` maps the pgvector column type: Prisma tracks it
// in migrations but cannot read or write it through the typed client, so
// embeddings go through raw queries in `src/modules/vector/vector.service.ts`.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  // NestJS 12 is ESM-only, so the client is generated as ESM too.
  moduleFormat    = "esm"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  // On Supabase these already exist in the `extensions` schema, so the
  // generated `CREATE EXTENSION IF NOT EXISTS` is a no-op there.
  extensions = [vector, pg_trgm]
}

enum Role {
  USER
  ADMIN
  /// CRM staff: leads, contracts, cases (0-07).
  CONSULTANT
  /// Document/material review staff (0-07) — no CRM access by default.
  DOC_OFFICER
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  password  String
  name      String?
  /// Needed for SMS-OTP contract signing (1C-08) — collected at accept-contract time if unset.
  phone     String?
  role      Role     @default(USER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens     RefreshToken[]
  documents         Document[]
  leads             Lead[]
  assignedLeads     Lead[]            @relation("LeadAssignee")
  leadActivities    LeadActivity[]
  posts             Post[]
  savedUniversities SavedUniversity[]

  cases                     Case[]
  assignedCasesAsConsultant Case[]           @relation("CaseConsultant")
  assignedCasesAsDocOfficer Case[]           @relation("CaseDocOfficer")
  caseTransitions           CaseTransition[]
  contracts                 Contract[]
  payments                  Payment[]

  @@index([createdAt])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  /// SHA-256 of the issued refresh token — the raw token is never stored.
  tokenHash String    @unique
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Document {
  id        String   @id @default(uuid()) @db.Uuid
  title     String
  source    String?
  metadata  Json     @default("{}")
  authorId  String?  @db.Uuid
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chunks DocumentChunk[]

  @@index([authorId])
  @@map("documents")
}

model DocumentChunk {
  id         String                       @id @default(uuid()) @db.Uuid
  documentId String                       @db.Uuid
  document   Document                     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  /// Position of this chunk inside the parent document.
  chunkIndex Int
  content    String
  /// pgvector column. Keep the dimension in sync with EMBEDDING_DIMENSIONS.
  embedding  Unsupported("vector(1536)")?
  createdAt  DateTime                     @default(now())

  @@unique([documentId, chunkIndex])
  @@index([documentId])
  @@map("document_chunks")
}

// ─────────────────────────────────────────────────────────────────────────────
// University reference data (ARCHITECTURE.md §3)
//
// Imported from /Users/user/korean-universities-data by `prisma/import-universities.ts`.
// Fields the dataset cannot know — whether the school takes Mongolian students,
// agent contract terms, internal notes — are edited by staff and the importer
// never overwrites them.
// ─────────────────────────────────────────────────────────────────────────────

enum UniversityType {
  NATIONAL
  PUBLIC
  PRIVATE
}

enum AgentContractStatus {
  NONE
  IN_TALKS
  SIGNED
  EXPIRED
}

/// A brokerage service line (ARCHITECTURE.md §5).
enum ServiceType {
  LANGUAGE_PREP
  BACHELOR
  MASTER
  PHD
  GKS_SCHOLARSHIP
}

/// What a university actually teaches — GKS_SCHOLARSHIP is a service, not a level.
enum ProgramLevel {
  LANGUAGE_PREP
  BACHELOR
  MASTER
  PHD
}

enum IntakeStatus {
  PLANNED
  OPEN
  CLOSED
}

model University {
  id     String         @id @default(uuid()) @db.Uuid
  slug   String         @unique
  nameKo String
  nameEn String
  nameMn String
  type   UniversityType

  foundedYear Int?
  cityEn      String
  cityMn      String
  regionEn    String
  regionMn    String
  address     String?
  lat         Float?
  lon         Float?

  logoPath  String?
  coverPath String?

  shortIntroMn          String?
  detailedIntroMn       String?
  studentsTotal         Int?
  /// Unfilled by design in the source dataset — render null as "мэдээлэл шинэчлэгдэж байна".
  internationalStudents Int?
  mongolianStudents     Int?
  numCampuses           Int?
  campusInfo            String?
  distanceFromSeoulKm   Float?
  travelTimeFromSeoul   String?
  /// Nearest metro/bus access — unfilled by design in the source dataset.
  nearestTransit        String?
  /// 3–6 editorial sentences in Mongolian; a human verifies these before launch.
  advantages            String[] @default([])

  /// Regional estimate: tier, monthly min/max, breakdown, isEstimate.
  livingCost Json?
  /// Usually null — the UI must render that as "мэдээлэл шинэчлэгдэж байна", not 0.
  dormitory  Json?
  /// officialWebsite, wikipedia, wikidata.
  links      Json  @default("{}")
  /// Per-field provenance: verified / editorial / estimated.
  quality    Json  @default("{}")

  // --- Staff-maintained; never touched by the importer ---
  acceptsLanguagePrep Boolean             @default(false)
  acceptsFromMongolia Boolean             @default(true)
  isGksEligible       Boolean             @default(false)
  agentContractStatus AgentContractStatus @default(NONE)
  /// Internal — commission terms, never exposed on public endpoints.
  commissionNote      String?
  /// Internal — staff notes, never exposed on public endpoints.
  internalNote        String?
  isPublished         Boolean             @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  programs UniversityProgram[]
  intakes  IntakeTerm[]
  savedBy  SavedUniversity[]
  cases    Case[]

  @@index([isPublished])
  @@index([regionEn])
  @@index([type])
  @@map("universities")
}

model UniversityProgram {
  id            String       @id @default(uuid()) @db.Uuid
  universityId  String       @db.Uuid
  university    University   @relation(fields: [universityId], references: [id], onDelete: Cascade)
  level         ProgramLevel
  nameMn        String
  nameEn        String?
  nameKo        String?
  /// Field of study, for filtering: "Инженерчлэл", "Бизнес" …
  faculty       String?
  durationYears Float?

  tuitionPerYearKrw Int?
  tuitionPerTermKrw Int?
  /// Minimum TOPIK level required for admission (1–6).
  topikLevel        Int?
  ieltsScore        Float?
  otherRequirements String?

  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cases Case[]

  @@unique([universityId, level, nameMn])
  @@index([universityId])
  @@index([level])
  @@map("university_programs")
}

/// Intake round. Language prep runs four a year, degree programmes two (§4.1, §4.2).
model IntakeTerm {
  id           String       @id @default(uuid()) @db.Uuid
  universityId String       @db.Uuid
  university   University   @relation(fields: [universityId], references: [id], onDelete: Cascade)
  level        ProgramLevel
  year         Int
  /// 3, 6, 9 or 12 — the Korean academic intake months.
  month        Int

  applicationDeadline DateTime?
  status              IntakeStatus @default(PLANNED)
  note                String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cases Case[]

  @@unique([universityId, level, year, month])
  @@index([universityId])
  @@index([year, month])
  @@map("intake_terms")
}

// ─────────────────────────────────────────────────────────────────────────────
// CRM — leads (ARCHITECTURE.md §4, gksedu.md §5.2)
// ─────────────────────────────────────────────────────────────────────────────

enum EducationLevel {
  SECONDARY_SCHOOL
  VOCATIONAL
  BACHELOR
  MASTER
  PHD
}

enum LeadSource {
  WEBSITE
  AI_CHAT
  PHONE
  SOCIAL
  OFFICE
  /// "Хэлний сургалтын төв" — the only trace the deferred MIRAE module leaves here.
  LANGUAGE_CENTER
  REFERRAL
  OTHER
}

enum LeadStage {
  NEW
  CONTACTED
  CONSULTED
  PROPOSAL_SENT
  CONTRACT_PENDING
  WON
  LOST
}

enum LeadActivityType {
  NOTE
  CALL
  MEETING
  MESSAGE
  EMAIL
  CHAT
  STAGE_CHANGE
}

model Lead {
  id     String  @id @default(uuid()) @db.Uuid
  /// Set once the lead registers an account.
  userId String? @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  firstName String
  lastName  String
  phone     String
  email     String?

  age            Int?
  educationLevel EducationLevel?
  gpa            Float?
  /// gksedu.md §24 question 1 — the GPA scale in use is still undecided.
  gpaScale       String?
  koreanLevel    String?
  englishLevel   String?

  interestedServices      ServiceType[] @default([])
  interestedUniversityIds String[]      @default([]) @db.Uuid
  interestedMajor         String?
  plannedIntakeId         String?       @db.Uuid

  source LeadSource
  stage  LeadStage  @default(NEW)

  assignedToId   String?   @db.Uuid
  assignedTo     User?     @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  nextContactAt  DateTime?
  /// gksedu.md §15.1 "гэрээ болох магадлал", 0–100.
  winProbability Int?
  lostReason     String?

  note String?
  /// Marketing attribution: utm_source/medium/campaign, referrer, landing page.
  utm  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities LeadActivity[]

  @@index([stage])
  @@index([assignedToId])
  @@index([source])
  @@index([createdAt])
  @@index([phone])
  @@map("leads")
}

model LeadActivity {
  id     String           @id @default(uuid()) @db.Uuid
  leadId String           @db.Uuid
  lead   Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type   LeadActivityType
  body   String?
  /// Type-specific payload: call duration, previous/next stage, channel …
  meta   Json             @default("{}")

  /// Null for system-generated entries.
  actorId String? @db.Uuid
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([leadId, occurredAt])
  @@map("lead_activities")
}

// ─────────────────────────────────────────────────────────────────────────────
// Saved universities (1A-18) — a logged-in visitor's shortlist.
// ─────────────────────────────────────────────────────────────────────────────

model SavedUniversity {
  id           String     @id @default(uuid()) @db.Uuid
  userId       String     @db.Uuid
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  universityId String     @db.Uuid
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, universityId])
  @@index([userId])
  @@map("saved_universities")
}

// ─────────────────────────────────────────────────────────────────────────────
// Content — blog/news and FAQ (1A-11, gksedu.md marketing site scope).
// ─────────────────────────────────────────────────────────────────────────────

enum PostStatus {
  DRAFT
  PUBLISHED
}

model Post {
  id      String  @id @default(uuid()) @db.Uuid
  slug    String  @unique
  title   String
  /// Short teaser shown on the list page and used as the OG/meta description fallback.
  excerpt String?
  /// Rendered as sanitized HTML on the frontend (ARCHITECTURE.md content pipeline).
  content String

  coverImagePath String?
  status         PostStatus @default(DRAFT)
  publishedAt    DateTime?

  authorId String? @db.Uuid
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  seoTitle       String?
  seoDescription String?
  tags           String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
  @@map("posts")
}

/// Content bucket a FAQ entry belongs to — labels live on the frontend (CLAUDE.md).
enum FaqCategory {
  GENERAL
  SERVICES
  PRICING
  DOCUMENTS
  VISA
  LANGUAGE_CENTER
}

model FaqItem {
  id       String      @id @default(uuid()) @db.Uuid
  category FaqCategory
  question String
  answer   String

  /// Manual sort order within a category; lower shows first.
  order       Int     @default(0)
  isPublished Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, order])
  @@map("faq_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// 1C — Contract & QPay payment (ARCHITECTURE.md §5, §6; gksedu.md §5.4, §5.5)
//
// `CaseFlowDefinition` carries the allowed stage graph as data (not a hardcoded
// map like `LEAD_STAGE_TRANSITIONS`) because the two service families — regular
// brokerage vs. GKS scholarship — order `BALANCE_PAID` differently around the
// visa step (§9, ARCHITECTURE.md §18 question 6 is still open on which order is
// authoritative; both are supported via `CaseFlowDefinition` rows per
// `serviceType`).
// ─────────────────────────────────────────────────────────────────────────────

enum PrepaymentMode {
  PERCENT
  FIXED
}

enum BalanceTrigger {
  AFTER_VISA_APPROVED
  AFTER_SCHOLARSHIP_RESULT
}

/// Union of both service families' stages (§5) plus escapes reachable from anywhere.
enum CaseStage {
  CONTRACT_DRAFT
  CONTRACT_SIGNED
  PREPAYMENT_PAID
  DOCUMENTS
  APPLICATION_SUBMITTED
  // Regular brokerage (language prep / BA / MA / PhD) only.
  ADMITTED
  TUITION_INVOICED
  INVITATION_RECEIVED
  // GKS scholarship only.
  GKS_ROUND1_PASSED
  GKS_ROUND2_PASSED
  VISA
  VISA_APPROVED
  BALANCE_PAID
  /// Regular brokerage language-prep only (gksedu.md §5.4 "Барьцааны гэрээ").
  COLLATERAL_CONTRACT
  PRE_DEPARTURE
  DEPARTED
  COMPLETED
  // Reachable from any stage.
  ON_HOLD
  CANCELLED
  REJECTED
}

enum ContractType {
  ELECTRONIC
  PHYSICAL
}

enum ContractStatus {
  DRAFT
  SENT
  SIGNED
  ACTIVE
  COMPLETED
  TERMINATED
}

enum PaymentKind {
  PREPAYMENT
  BALANCE
  SCHOOL_TUITION
  TRANSFER_FEE
  EXTRA_SERVICE
  REFUND
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

/// Versioned service pricing (gksedu.md §5.4) — admin-configurable, never a constant.
model ServicePricing {
  id              String         @id @default(uuid()) @db.Uuid
  serviceType     ServiceType
  totalAmount     Decimal        @db.Decimal(14, 2)
  prepaymentMode  PrepaymentMode
  prepaymentValue Decimal        @db.Decimal(14, 2)
  balanceTrigger  BalanceTrigger
  effectiveFrom   DateTime
  /// Null = currently active.
  effectiveTo     DateTime?
  createdAt       DateTime       @default(now())

  @@index([serviceType, effectiveFrom])
  @@map("service_pricing")
}

/// One user × one service × one target university × one intake (§5).
model Case {
  id     String @id @default(uuid()) @db.Uuid
  /// Human-readable, e.g. GKS-2026-0417.
  code   String @unique
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  serviceType  ServiceType
  universityId String?            @db.Uuid
  university   University?        @relation(fields: [universityId], references: [id], onDelete: SetNull)
  programId    String?            @db.Uuid
  program      UniversityProgram? @relation(fields: [programId], references: [id], onDelete: SetNull)
  intakeId     String?            @db.Uuid
  intake       IntakeTerm?        @relation(fields: [intakeId], references: [id], onDelete: SetNull)

  stage CaseStage @default(CONTRACT_DRAFT)

  assignedConsultantId String? @db.Uuid
  assignedConsultant   User?   @relation("CaseConsultant", fields: [assignedConsultantId], references: [id], onDelete: SetNull)
  assignedDocOfficerId String? @db.Uuid
  assignedDocOfficer   User?   @relation("CaseDocOfficer", fields: [assignedDocOfficerId], references: [id], onDelete: SetNull)

  contract    Contract?
  payments    Payment[]
  transitions CaseTransition[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([stage])
  @@index([assignedConsultantId])
  @@index([assignedDocOfficerId])
  @@map("cases")
}

model CaseTransition {
  id        String    @id @default(uuid()) @db.Uuid
  caseId    String    @db.Uuid
  case      Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  fromStage CaseStage
  toStage   CaseStage
  reason    String?
  /// Null for system-triggered transitions (e.g. payment confirmed).
  actorId   String?   @db.Uuid
  actor     User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt DateTime  @default(now())

  @@index([caseId, createdAt])
  @@map("case_transitions")
}

/// Allowed stage graph, per service type — data, not code (see file-header note).
model CaseFlowDefinition {
  id           String      @id @default(uuid()) @db.Uuid
  serviceType  ServiceType
  fromStage    CaseStage
  toStage      CaseStage
  /// Empty = no staff role may trigger this manually (system-only).
  allowedRoles Role[]
  /// True when only `confirmPayment`/other system logic makes this transition.
  isSystemOnly Boolean     @default(false)
  sortOrder    Int         @default(0)

  @@unique([serviceType, fromStage, toStage])
  @@index([serviceType, fromStage])
  @@map("case_flow_definitions")
}

model Contract {
  id     String @id @default(uuid()) @db.Uuid
  caseId String @unique @db.Uuid
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  type   ContractType
  status ContractStatus @default(DRAFT)

  // Pricing snapshot taken when the contract is issued (§6.1) — a later price
  // change never rewrites an existing contract.
  totalAmountSnapshot     Decimal        @db.Decimal(14, 2)
  prepaymentModeSnapshot  PrepaymentMode
  prepaymentValueSnapshot Decimal        @db.Decimal(14, 2)
  balanceTriggerSnapshot  BalanceTrigger
  /// Refund conditions, visa-rejection terms, extra-service terms (§5.4) — free-form per template.
  refundPolicy            Json

  /// Fully rendered contract text (template placeholders already substituted).
  bodyMn  String
  pdfPath String?

  sentAt           DateTime?
  acceptedAt       DateTime?
  otpVerifiedAt    DateTime?
  signedAt         DateTime?
  signedIp         String?
  /// Staff-uploaded scan for a PHYSICAL contract (1C-09).
  physicalScanPath String?

  collateralContract CollateralContract?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@map("contracts")
}

/// Real-estate/asset collateral for language-prep visa-stage risk (gksedu.md §5.4) —
/// deliberately thin: the appraisal and collateral terms live in the physical document.
model CollateralContract {
  id         String    @id @default(uuid()) @db.Uuid
  contractId String    @unique @db.Uuid
  contract   Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  isSigned   Boolean   @default(false)
  startDate  DateTime?
  endDate    DateTime?
  filePath   String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("collateral_contracts")
}

/// Admin-editable contract text with `{{placeholder}}` tokens (1C-06).
model ContractTemplate {
  id          String      @id @default(uuid()) @db.Uuid
  serviceType ServiceType
  version     Int         @default(1)
  isActive    Boolean     @default(true)
  bodyMn      String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([serviceType, version])
  @@index([serviceType, isActive])
  @@map("contract_templates")
}

model Payment {
  id     String @id @default(uuid()) @db.Uuid
  caseId String @db.Uuid
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  kind      PaymentKind
  amountMnt Decimal       @db.Decimal(14, 2)
  /// Set for SCHOOL_TUITION payments (§8).
  amountKrw Decimal?      @db.Decimal(14, 2)
  fxRate    Decimal?      @db.Decimal(10, 4)
  status    PaymentStatus @default(PENDING)

  qpayInvoiceId String? @unique
  qpayPaymentId String?
  qrText        String?
  qrImage       String?

  paidAt      DateTime?
  receiptPath String?
  dueAt       DateTime?

  /// Set on a REFUND row — the payment it refunds.
  refundOfId String?   @db.Uuid
  refundOf   Payment?  @relation("PaymentRefund", fields: [refundOfId], references: [id], onDelete: SetNull)
  refunds    Payment[] @relation("PaymentRefund")

  createdById String? @db.Uuid
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([caseId])
  @@index([status])
  @@map("payments")
}
