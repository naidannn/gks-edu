// Prisma schema — PostgreSQL 17 with the pgvector extension.
//
// Prisma 7 keeps connection URLs out of this file; they live in
// `prisma.config.ts` (CLI) and in the driver adapter (`PrismaService`).
//
// `Unsupported("vector(1536)")` maps the pgvector column type: Prisma tracks it
// in migrations but cannot read or write it through the typed client, so
// embeddings go through raw queries in `src/modules/vector/vector.service.ts`.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  // NestJS 12 is ESM-only, so the client is generated as ESM too.
  moduleFormat    = "esm"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  // On Supabase these already exist in the `extensions` schema, so the
  // generated `CREATE EXTENSION IF NOT EXISTS` is a no-op there.
  extensions = [vector, pg_trgm]
}

enum Role {
  USER
  ADMIN
  /// CRM staff: leads, contracts, cases (0-07).
  CONSULTANT
  /// Document/material review staff (0-07) — no CRM access by default.
  DOC_OFFICER
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  /// Null for a staff-created client who has not claimed a portal login yet (1B-14).
  email     String?  @unique
  /// Null until the account is claimed — such a row cannot pass `login`.
  password  String?
  name      String?
  /// Needed for SMS-OTP contract signing (1C-08) — collected at accept-contract time if unset.
  phone     String?
  role      Role     @default(USER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens     RefreshToken[]
  documents         Document[]
  leads             Lead[]
  assignedLeads     Lead[]            @relation("LeadAssignee")
  leadActivities    LeadActivity[]
  posts             Post[]
  savedUniversities SavedUniversity[]

  client          Client?
  assignedClients Client[] @relation("ClientConsultant")
  createdClients  Client[] @relation("ClientCreatedBy")

  cases                     Case[]
  assignedCasesAsConsultant Case[]           @relation("CaseConsultant")
  assignedCasesAsDocOfficer Case[]           @relation("CaseDocOfficer")
  caseTransitions           CaseTransition[]
  contracts                 Contract[]
  payments                  Payment[]

  caseConditions      CaseConditions[]
  documentFiles       DocumentFile[]
  documentReviewNotes DocumentReviewNote[]
  assignedWorkTasks   WorkTask[]           @relation("WorkTaskAssignee")
  createdWorkTasks    WorkTask[]           @relation("WorkTaskCreator")
  officeAppointments  OfficeAppointment[]
  applicationResults  ApplicationResult[]
  invitations         Invitation[]

  @@index([createdAt])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  /// SHA-256 of the issued refresh token — the raw token is never stored.
  tokenHash String    @unique
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Document {
  id        String   @id @default(uuid()) @db.Uuid
  title     String
  source    String?
  metadata  Json     @default("{}")
  authorId  String?  @db.Uuid
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chunks DocumentChunk[]

  @@index([authorId])
  @@map("documents")
}

model DocumentChunk {
  id         String                       @id @default(uuid()) @db.Uuid
  documentId String                       @db.Uuid
  document   Document                     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  /// Position of this chunk inside the parent document.
  chunkIndex Int
  content    String
  /// pgvector column. Keep the dimension in sync with EMBEDDING_DIMENSIONS.
  embedding  Unsupported("vector(1536)")?
  createdAt  DateTime                     @default(now())

  @@unique([documentId, chunkIndex])
  @@index([documentId])
  @@map("document_chunks")
}

// ─────────────────────────────────────────────────────────────────────────────
// University reference data (ARCHITECTURE.md §3)
//
// Imported from /Users/user/korean-universities-data by `prisma/import-universities.ts`.
// Fields the dataset cannot know — whether the school takes Mongolian students,
// agent contract terms, internal notes — are edited by staff and the importer
// never overwrites them.
// ─────────────────────────────────────────────────────────────────────────────

enum UniversityType {
  NATIONAL
  PUBLIC
  PRIVATE
}

enum AgentContractStatus {
  NONE
  IN_TALKS
  SIGNED
  EXPIRED
}

/// A brokerage service line (ARCHITECTURE.md §5).
enum ServiceType {
  LANGUAGE_PREP
  BACHELOR
  MASTER
  PHD
  GKS_SCHOLARSHIP
}

/// What a university actually teaches — GKS_SCHOLARSHIP is a service, not a level.
enum ProgramLevel {
  LANGUAGE_PREP
  BACHELOR
  MASTER
  PHD
}

enum IntakeStatus {
  PLANNED
  OPEN
  CLOSED
}

model University {
  id     String         @id @default(uuid()) @db.Uuid
  slug   String         @unique
  nameKo String
  nameEn String
  nameMn String
  type   UniversityType

  foundedYear Int?
  cityEn      String
  cityMn      String
  regionEn    String
  regionMn    String
  address     String?
  lat         Float?
  lon         Float?

  logoPath  String?
  coverPath String?

  shortIntroMn          String?
  detailedIntroMn       String?
  studentsTotal         Int?
  /// Unfilled by design in the source dataset — render null as "мэдээлэл шинэчлэгдэж байна".
  internationalStudents Int?
  mongolianStudents     Int?
  numCampuses           Int?
  campusInfo            String?
  distanceFromSeoulKm   Float?
  travelTimeFromSeoul   String?
  /// Nearest metro/bus access — unfilled by design in the source dataset.
  nearestTransit        String?
  /// 3–6 editorial sentences in Mongolian; a human verifies these before launch.
  advantages            String[] @default([])

  /// Regional estimate: tier, monthly min/max, breakdown, isEstimate.
  livingCost Json?
  /// Usually null — the UI must render that as "мэдээлэл шинэчлэгдэж байна", not 0.
  dormitory  Json?
  /// officialWebsite, wikipedia, wikidata.
  links      Json  @default("{}")
  /// Per-field provenance: verified / editorial / estimated.
  quality    Json  @default("{}")

  // --- Staff-maintained; never touched by the importer ---
  acceptsLanguagePrep Boolean             @default(false)
  acceptsFromMongolia Boolean             @default(true)
  isGksEligible       Boolean             @default(false)
  agentContractStatus AgentContractStatus @default(NONE)
  /// Internal — commission terms, never exposed on public endpoints.
  commissionNote      String?
  /// Internal — staff notes, never exposed on public endpoints.
  internalNote        String?
  isPublished         Boolean             @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  programs UniversityProgram[]
  intakes  IntakeTerm[]
  savedBy  SavedUniversity[]
  cases    Case[]
  clients  Client[]

  requirementRules RequirementRule[]
  applications     Application[]

  @@index([isPublished])
  @@index([regionEn])
  @@index([type])
  @@map("universities")
}

model UniversityProgram {
  id            String       @id @default(uuid()) @db.Uuid
  universityId  String       @db.Uuid
  university    University   @relation(fields: [universityId], references: [id], onDelete: Cascade)
  level         ProgramLevel
  nameMn        String
  nameEn        String?
  nameKo        String?
  /// Field of study, for filtering: "Инженерчлэл", "Бизнес" …
  faculty       String?
  durationYears Float?

  tuitionPerYearKrw Int?
  tuitionPerTermKrw Int?
  /// Minimum TOPIK level required for admission (1–6).
  topikLevel        Int?
  ieltsScore        Float?
  otherRequirements String?

  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cases        Case[]
  applications Application[]

  @@unique([universityId, level, nameMn])
  @@index([universityId])
  @@index([level])
  @@map("university_programs")
}

/// Intake round. Language prep runs four a year, degree programmes two (§4.1, §4.2).
model IntakeTerm {
  id           String       @id @default(uuid()) @db.Uuid
  universityId String       @db.Uuid
  university   University   @relation(fields: [universityId], references: [id], onDelete: Cascade)
  level        ProgramLevel
  year         Int
  /// 3, 6, 9 or 12 — the Korean academic intake months.
  month        Int

  applicationDeadline DateTime?
  status              IntakeStatus @default(PLANNED)
  note                String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cases        Case[]
  clients      Client[]
  applications Application[]

  @@unique([universityId, level, year, month])
  @@index([universityId])
  @@index([year, month])
  @@map("intake_terms")
}

// ─────────────────────────────────────────────────────────────────────────────
// CRM — leads (ARCHITECTURE.md §4, gksedu.md §5.2)
// ─────────────────────────────────────────────────────────────────────────────

enum EducationLevel {
  SECONDARY_SCHOOL
  VOCATIONAL
  BACHELOR
  MASTER
  PHD
}

enum LeadSource {
  WEBSITE
  AI_CHAT
  PHONE
  SOCIAL
  OFFICE
  /// "Хэлний сургалтын төв" — the only trace the deferred MIRAE module leaves here.
  LANGUAGE_CENTER
  REFERRAL
  OTHER
}

enum LeadStage {
  NEW
  CONTACTED
  CONSULTED
  PROPOSAL_SENT
  CONTRACT_PENDING
  WON
  LOST
}

enum LeadActivityType {
  NOTE
  CALL
  MEETING
  MESSAGE
  EMAIL
  CHAT
  STAGE_CHANGE
}

model Lead {
  id     String  @id @default(uuid()) @db.Uuid
  /// Set once the lead registers an account.
  userId String? @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  firstName String
  lastName  String
  phone     String
  email     String?

  age            Int?
  educationLevel EducationLevel?
  gpa            Float?
  /// gksedu.md §24 question 1 — the GPA scale in use is still undecided.
  gpaScale       String?
  koreanLevel    String?
  englishLevel   String?

  interestedServices      ServiceType[] @default([])
  interestedUniversityIds String[]      @default([]) @db.Uuid
  interestedMajor         String?
  plannedIntakeId         String?       @db.Uuid

  source LeadSource
  stage  LeadStage  @default(NEW)

  assignedToId   String?   @db.Uuid
  assignedTo     User?     @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  nextContactAt  DateTime?
  /// gksedu.md §15.1 "гэрээ болох магадлал", 0–100.
  winProbability Int?
  lostReason     String?

  note String?
  /// Marketing attribution: utm_source/medium/campaign, referrer, landing page.
  utm  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities LeadActivity[]
  /// Set once staff convert this lead into a client (1B-10) — the lead row stays as history.
  client     Client?

  @@index([stage])
  @@index([assignedToId])
  @@index([source])
  @@index([createdAt])
  @@index([phone])
  @@map("leads")
}

model LeadActivity {
  id     String           @id @default(uuid()) @db.Uuid
  leadId String           @db.Uuid
  lead   Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type   LeadActivityType
  body   String?
  /// Type-specific payload: call duration, previous/next stage, channel …
  meta   Json             @default("{}")

  /// Null for system-generated entries.
  actorId String? @db.Uuid
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([leadId, occurredAt])
  @@map("lead_activities")
}

// ─────────────────────────────────────────────────────────────────────────────
// Client (гэрээт харилцагч) — 1B-14.
//
// A `Lead` is a pre-contract enquiry; a `Client` is a person the office has
// taken on. The two are deliberately separate tables: converting a lead copies
// what is still true into a client row and leaves the lead as sales history.
//
// A client is always backed by a `User` row, because `Case`, `Contract` and
// `Payment` all hang off `userId`. That row carries no email/password until the
// client claims a portal login — staff-created clients never get a fake account.
// ─────────────────────────────────────────────────────────────────────────────

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ClientStatus {
  /// In an active service cycle, or waiting to start one.
  ACTIVE
  /// No live case; kept for history and repeat business.
  INACTIVE
  ARCHIVED
}

model Client {
  id     String  @id @default(uuid()) @db.Uuid
  /// Human-readable, e.g. KH-2026-0042.
  code   String  @unique
  /// The account rows Case/Contract/Payment point at — created together with the client.
  userId String  @unique @db.Uuid
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The enquiry this client was converted from, if any (1B-10).
  leadId String? @unique @db.Uuid
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  // ── Identity — what the brokerage contract is written against (§6.2).
  lastName       String
  firstName      String
  birthDate      DateTime @db.Date
  /// Регистрийн дугаар — 2 Cyrillic letters + 8 digits, validated in the DTO.
  registerNumber String   @unique
  gender         Gender?
  phone          String
  phoneAlt       String?
  email          String?
  address        String?

  // ── Guardian (төлөөлөн гэрээ байгуулагч) — required while the client is a
  //    minor on the contract date; kept afterwards as the signed record.
  guardianLastName       String?
  guardianFirstName      String?
  guardianRegisterNumber String?
  guardianPhone          String?
  /// Free text: "Эх", "Эцэг", "Асран хамгаалагч" …
  guardianRelation       String?

  // ── Academic background carried over from the lead, kept editable here.
  educationLevel EducationLevel?
  schoolName     String?
  gpa            Float?
  /// gksedu.md §24 question 1 — the GPA scale in use is still undecided.
  gpaScale       String?
  koreanLevel    String?
  englishLevel   String?
  passportNumber String?
  passportExpiry DateTime?

  // ── What the client signed up for. The authoritative per-service state lives
  //    on `Case`; these are the choice made at registration time.
  primaryServiceType ServiceType
  targetUniversityId String?     @db.Uuid
  targetUniversity   University? @relation(fields: [targetUniversityId], references: [id], onDelete: SetNull)
  targetMajor        String?
  plannedIntakeId    String?     @db.Uuid
  plannedIntake      IntakeTerm? @relation(fields: [plannedIntakeId], references: [id], onDelete: SetNull)

  source LeadSource   @default(OFFICE)
  status ClientStatus @default(ACTIVE)
  note   String?

  assignedConsultantId String? @db.Uuid
  assignedConsultant   User?   @relation("ClientConsultant", fields: [assignedConsultantId], references: [id], onDelete: SetNull)
  createdById          String? @db.Uuid
  createdBy            User?   @relation("ClientCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([assignedConsultantId])
  @@index([primaryServiceType])
  @@index([createdAt])
  @@index([phone])
  @@index([lastName, firstName])
  @@map("clients")
}

// ─────────────────────────────────────────────────────────────────────────────
// Saved universities (1A-18) — a logged-in visitor's shortlist.
// ─────────────────────────────────────────────────────────────────────────────

model SavedUniversity {
  id           String     @id @default(uuid()) @db.Uuid
  userId       String     @db.Uuid
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  universityId String     @db.Uuid
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, universityId])
  @@index([userId])
  @@map("saved_universities")
}

// ─────────────────────────────────────────────────────────────────────────────
// Content — blog/news and FAQ (1A-11, gksedu.md marketing site scope).
// ─────────────────────────────────────────────────────────────────────────────

enum PostStatus {
  DRAFT
  PUBLISHED
}

model Post {
  id      String  @id @default(uuid()) @db.Uuid
  slug    String  @unique
  title   String
  /// Short teaser shown on the list page and used as the OG/meta description fallback.
  excerpt String?
  /// Rendered as sanitized HTML on the frontend (ARCHITECTURE.md content pipeline).
  content String

  coverImagePath String?
  status         PostStatus @default(DRAFT)
  publishedAt    DateTime?

  authorId String? @db.Uuid
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  seoTitle       String?
  seoDescription String?
  tags           String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
  @@map("posts")
}

/// Content bucket a FAQ entry belongs to — labels live on the frontend (CLAUDE.md).
enum FaqCategory {
  GENERAL
  SERVICES
  PRICING
  DOCUMENTS
  VISA
  LANGUAGE_CENTER
}

model FaqItem {
  id       String      @id @default(uuid()) @db.Uuid
  category FaqCategory
  question String
  answer   String

  /// Manual sort order within a category; lower shows first.
  order       Int     @default(0)
  isPublished Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, order])
  @@map("faq_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// 1C — Contract & QPay payment (ARCHITECTURE.md §5, §6; gksedu.md §5.4, §5.5)
//
// `CaseFlowDefinition` carries the allowed stage graph as data (not a hardcoded
// map like `LEAD_STAGE_TRANSITIONS`) because the two service families — regular
// brokerage vs. GKS scholarship — order `BALANCE_PAID` differently around the
// visa step (§9, ARCHITECTURE.md §18 question 6 is still open on which order is
// authoritative; both are supported via `CaseFlowDefinition` rows per
// `serviceType`).
// ─────────────────────────────────────────────────────────────────────────────

enum PrepaymentMode {
  PERCENT
  FIXED
}

enum BalanceTrigger {
  AFTER_VISA_APPROVED
  AFTER_SCHOLARSHIP_RESULT
}

/// Union of both service families' stages (§5) plus escapes reachable from anywhere.
enum CaseStage {
  CONTRACT_DRAFT
  CONTRACT_SIGNED
  PREPAYMENT_PAID
  DOCUMENTS
  APPLICATION_SUBMITTED
  // Regular brokerage (language prep / BA / MA / PhD) only.
  ADMITTED
  TUITION_INVOICED
  INVITATION_RECEIVED
  // GKS scholarship only.
  GKS_ROUND1_PASSED
  GKS_ROUND2_PASSED
  VISA
  VISA_APPROVED
  BALANCE_PAID
  /// Regular brokerage language-prep only (gksedu.md §5.4 "Барьцааны гэрээ").
  COLLATERAL_CONTRACT
  PRE_DEPARTURE
  DEPARTED
  COMPLETED
  // Reachable from any stage.
  ON_HOLD
  CANCELLED
  REJECTED
}

enum ContractType {
  ELECTRONIC
  PHYSICAL
}

enum ContractStatus {
  DRAFT
  SENT
  SIGNED
  ACTIVE
  COMPLETED
  TERMINATED
}

enum PaymentKind {
  PREPAYMENT
  BALANCE
  SCHOOL_TUITION
  TRANSFER_FEE
  EXTRA_SERVICE
  REFUND
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

/// Versioned service pricing (gksedu.md §5.4) — admin-configurable, never a constant.
model ServicePricing {
  id              String         @id @default(uuid()) @db.Uuid
  serviceType     ServiceType
  totalAmount     Decimal        @db.Decimal(14, 2)
  prepaymentMode  PrepaymentMode
  prepaymentValue Decimal        @db.Decimal(14, 2)
  balanceTrigger  BalanceTrigger
  effectiveFrom   DateTime
  /// Null = currently active.
  effectiveTo     DateTime?
  createdAt       DateTime       @default(now())

  @@index([serviceType, effectiveFrom])
  @@map("service_pricing")
}

/// One user × one service × one target university × one intake (§5).
model Case {
  id     String @id @default(uuid()) @db.Uuid
  /// Human-readable, e.g. GKS-2026-0417.
  code   String @unique
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  serviceType  ServiceType
  universityId String?            @db.Uuid
  university   University?        @relation(fields: [universityId], references: [id], onDelete: SetNull)
  programId    String?            @db.Uuid
  program      UniversityProgram? @relation(fields: [programId], references: [id], onDelete: SetNull)
  intakeId     String?            @db.Uuid
  intake       IntakeTerm?        @relation(fields: [intakeId], references: [id], onDelete: SetNull)

  stage CaseStage @default(CONTRACT_DRAFT)

  assignedConsultantId String? @db.Uuid
  assignedConsultant   User?   @relation("CaseConsultant", fields: [assignedConsultantId], references: [id], onDelete: SetNull)
  assignedDocOfficerId String? @db.Uuid
  assignedDocOfficer   User?   @relation("CaseDocOfficer", fields: [assignedDocOfficerId], references: [id], onDelete: SetNull)

  contract    Contract?
  payments    Payment[]
  transitions CaseTransition[]

  conditions     CaseConditions?
  documents      CaseDocument[]
  workTasks      WorkTask[]
  appointments   OfficeAppointment[]
  application    Application?
  schoolInvoices SchoolInvoice[]
  invitation     Invitation?
  visaCase       VisaCase?
  departurePlan  DeparturePlan?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([stage])
  @@index([assignedConsultantId])
  @@index([assignedDocOfficerId])
  @@map("cases")
}

model CaseTransition {
  id        String    @id @default(uuid()) @db.Uuid
  caseId    String    @db.Uuid
  case      Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  fromStage CaseStage
  toStage   CaseStage
  reason    String?
  /// Null for system-triggered transitions (e.g. payment confirmed).
  actorId   String?   @db.Uuid
  actor     User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt DateTime  @default(now())

  @@index([caseId, createdAt])
  @@map("case_transitions")
}

/// Allowed stage graph, per service type — data, not code (see file-header note).
model CaseFlowDefinition {
  id           String      @id @default(uuid()) @db.Uuid
  serviceType  ServiceType
  fromStage    CaseStage
  toStage      CaseStage
  /// Empty = no staff role may trigger this manually (system-only).
  allowedRoles Role[]
  /// True when only `confirmPayment`/other system logic makes this transition.
  isSystemOnly Boolean     @default(false)
  sortOrder    Int         @default(0)

  @@unique([serviceType, fromStage, toStage])
  @@index([serviceType, fromStage])
  @@map("case_flow_definitions")
}

model Contract {
  id     String @id @default(uuid()) @db.Uuid
  caseId String @unique @db.Uuid
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  type   ContractType
  status ContractStatus @default(DRAFT)

  // Pricing snapshot taken when the contract is issued (§6.1) — a later price
  // change never rewrites an existing contract.
  totalAmountSnapshot     Decimal        @db.Decimal(14, 2)
  prepaymentModeSnapshot  PrepaymentMode
  prepaymentValueSnapshot Decimal        @db.Decimal(14, 2)
  balanceTriggerSnapshot  BalanceTrigger
  /// Refund conditions, visa-rejection terms, extra-service terms (§5.4) — free-form per template.
  refundPolicy            Json

  /// Fully rendered contract text (template placeholders already substituted).
  bodyMn  String
  pdfPath String?

  sentAt           DateTime?
  acceptedAt       DateTime?
  otpVerifiedAt    DateTime?
  signedAt         DateTime?
  signedIp         String?
  /// Staff-uploaded scan for a PHYSICAL contract (1C-09).
  physicalScanPath String?

  collateralContract CollateralContract?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@map("contracts")
}

/// Real-estate/asset collateral for language-prep visa-stage risk (gksedu.md §5.4) —
/// deliberately thin: the appraisal and collateral terms live in the physical document.
model CollateralContract {
  id         String    @id @default(uuid()) @db.Uuid
  contractId String    @unique @db.Uuid
  contract   Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  isSigned   Boolean   @default(false)
  startDate  DateTime?
  endDate    DateTime?
  filePath   String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("collateral_contracts")
}

/// Admin-editable contract text with `{{placeholder}}` tokens (1C-06).
model ContractTemplate {
  id          String      @id @default(uuid()) @db.Uuid
  serviceType ServiceType
  version     Int         @default(1)
  isActive    Boolean     @default(true)
  bodyMn      String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([serviceType, version])
  @@index([serviceType, isActive])
  @@map("contract_templates")
}

model Payment {
  id     String @id @default(uuid()) @db.Uuid
  caseId String @db.Uuid
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  kind      PaymentKind
  amountMnt Decimal       @db.Decimal(14, 2)
  /// Set for SCHOOL_TUITION payments (§8).
  amountKrw Decimal?      @db.Decimal(14, 2)
  fxRate    Decimal?      @db.Decimal(10, 4)
  status    PaymentStatus @default(PENDING)

  qpayInvoiceId String? @unique
  qpayPaymentId String?
  qrText        String?
  qrImage       String?

  paidAt      DateTime?
  receiptPath String?
  dueAt       DateTime?

  /// Set on a REFUND row — the payment it refunds.
  refundOfId String?   @db.Uuid
  refundOf   Payment?  @relation("PaymentRefund", fields: [refundOfId], references: [id], onDelete: SetNull)
  refunds    Payment[] @relation("PaymentRefund")

  createdById String? @db.Uuid
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([caseId])
  @@index([status])
  @@map("payments")
}

// ─────────────────────────────────────────────────────────────────────────────
// 1D — Document requirement engine (ARCHITECTURE.md §7, gksedu.md §6).
//
// The list a client must collect is *derived*, never typed by hand: templates
// describe a document, `RequirementRule` rows say under which conditions it is
// needed, and the resolver intersects those rules with one case's conditions.
// Re-running the resolver after a condition changes only *adds* rows — an
// already-submitted document is never deleted (§7.1).
// ─────────────────────────────────────────────────────────────────────────────

/// Which collection round a rule belongs to — school admission (§6) or visa (§10).
enum DocStage {
  ADMISSION
  VISA
}

/// The sponsor's occupation decides which financial papers are required (§6.1).
enum GuarantorType {
  NONE
  EMPLOYEE
  COMPANY_DIRECTOR
  SELF_EMPLOYED
}

/// Who the guarantor is to the applicant. Anything but a parent adds the
/// kinship reference ("төрөл садангийн лавлагаа").
enum GuarantorRelation {
  PARENT
  SIBLING
  UNCLE_AUNT
  OTHER
}

enum Necessity {
  REQUIRED
  CONDITIONAL
  OPTIONAL
}

/// The 12 states of gksedu.md §6.2, in flow order.
enum DocumentStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  UNDER_REVIEW
  NEEDS_FIX
  RESUBMIT_REQUIRED
  ACCEPTED
  IN_TRANSLATION
  TRANSLATED
  CERTIFIED
  READY
  SENT_TO_UNIVERSITY
}

/// What a single document *is* — independent of who needs it (§7.1).
model DocumentTemplate {
  id            String  @id @default(uuid()) @db.Uuid
  /// Stable machine code, e.g. PASSPORT, HS_TRANSCRIPT.
  code          String  @unique
  nameMn        String
  descriptionMn String?
  /// Where to get it: "E-Mongolia-аас".
  sourceHint    String?
  /// Which authority certifies it.
  issuerHint    String?
  /// How long the issued paper stays valid; null = indefinite.
  validityDays  Int?

  needsTranslation      Boolean @default(false)
  needsNotary           Boolean @default(false)
  needsApostille        Boolean @default(false)
  /// "Эх хувиар авчрах" — cannot be closed out online (1D-11).
  needsPhysicalOriginal Boolean @default(false)

  acceptedFileTypes String[] @default(["pdf", "jpg", "png"])
  sampleFilePath    String?
  tipsMn            String?
  isActive          Boolean  @default(true)

  rules         RequirementRule[]
  caseDocuments CaseDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("document_templates")
}

/// One condition → document mapping. Empty array = "applies to all" for that
/// dimension, which keeps the common rules short (§7.1).
model RequirementRule {
  id         String           @id @default(uuid()) @db.Uuid
  templateId String           @db.Uuid
  template   DocumentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  stage              DocStage
  // `@default([])` matters: without it an omitted array is written as SQL NULL,
  // which no `isEmpty` filter matches — and "empty means everyone" is the whole
  // shape of the rule base (§7.1).
  serviceTypes       ServiceType[]       @default([])
  educationLevels    EducationLevel[]    @default([])
  guarantorTypes     GuarantorType[]     @default([])
  guarantorRelations GuarantorRelation[] @default([])
  /// Null = every university; set for a school's extra requirement (1D-18).
  universityId       String?             @db.Uuid
  university         University?         @relation(fields: [universityId], references: [id], onDelete: Cascade)

  necessity     Necessity @default(REQUIRED)
  /// "байгаа тохиолдолд", "манай байгууллагаас шаардсан үед" …
  conditionNote String?
  sortOrder     Int       @default(0)
  isActive      Boolean   @default(true)

  caseDocuments CaseDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stage, isActive])
  @@index([templateId])
  @@index([universityId])
  @@map("requirement_rules")
}

/// The client's answers that drive rule resolution (1D-06). Kept apart from
/// `Client` because a person may run two cases with different sponsors.
model CaseConditions {
  id     String @id @default(uuid()) @db.Uuid
  caseId String @unique @db.Uuid
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  educationLevel    EducationLevel?
  guarantorType     GuarantorType      @default(NONE)
  guarantorRelation GuarantorRelation?
  guarantorName     String?
  guarantorPhone    String?
  note              String?

  answeredById String? @db.Uuid
  answeredBy   User?   @relation(fields: [answeredById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("case_conditions")
}

/// One required document on one case — the row the client actually works on.
model CaseDocument {
  id     String @id @default(uuid()) @db.Uuid
  caseId String @db.Uuid
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  templateId String           @db.Uuid
  template   DocumentTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  /// The rule that produced this row; null once that rule is deleted or when
  /// staff added the document by hand.
  ruleId     String?          @db.Uuid
  rule       RequirementRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  stage         DocStage
  necessity     Necessity      @default(REQUIRED)
  conditionNote String?
  status        DocumentStatus @default(NOT_STARTED)
  sortOrder     Int            @default(0)
  /// Deadline driving the D-7/D-3/D-1 reminders (1D-12).
  dueAt         DateTime?

  submittedAt        DateTime?
  acceptedAt         DateTime?
  readyAt            DateTime?
  sentToUniversityAt DateTime?
  /// Soft delete (ARCHITECTURE.md §9) — a de-required document is hidden, not erased.
  deletedAt          DateTime?

  files     DocumentFile[]
  notes     DocumentReviewNote[]
  workTasks WorkTask[]
  reminders DocumentReminder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([caseId, templateId, stage])
  @@index([caseId, stage])
  @@index([status])
  @@index([dueAt])
  @@map("case_documents")
}

/// A version of an uploaded document (§15.4) — resubmissions keep their history.
model DocumentFile {
  id             String       @id @default(uuid()) @db.Uuid
  caseDocumentId String       @db.Uuid
  caseDocument   CaseDocument @relation(fields: [caseDocumentId], references: [id], onDelete: Cascade)

  version      Int
  /// Storage path — reachable only through a signed token (§9).
  path         String
  originalName String
  sizeBytes    Int
  mimeType     String
  /// The staff-approved final copy (e.g. the certified translation).
  isFinal      Boolean @default(false)

  uploadedById String? @db.Uuid
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  deletedAt DateTime?
  createdAt DateTime  @default(now())

  @@unique([caseDocumentId, version])
  @@index([caseDocumentId])
  @@map("document_files")
}

/// Staff comment attached to a review action (§6.3) — the client reads these to
/// understand what to fix.
model DocumentReviewNote {
  id             String       @id @default(uuid()) @db.Uuid
  caseDocumentId String       @db.Uuid
  caseDocument   CaseDocument @relation(fields: [caseDocumentId], references: [id], onDelete: Cascade)

  authorId String? @db.Uuid
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  body       String
  fromStatus DocumentStatus?
  toStatus   DocumentStatus?
  /// Internal notes stay hidden from the client's checklist.
  isInternal Boolean         @default(false)

  createdAt DateTime @default(now())

  @@index([caseDocumentId, createdAt])
  @@map("document_review_notes")
}

/// Back-office work on a case (§6.4): translation, form filling, essays …
enum WorkTaskType {
  TRANSLATION
  NOTARISATION
  FORM_FILLING
  STUDY_PLAN
  SELF_INTRODUCTION
  SCHOLARSHIP_ESSAY
  COMPLETENESS_CHECK
  FILE_MERGE
  FINAL_REVIEW
  OTHER
}

enum WorkTaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

model WorkTask {
  id             String        @id @default(uuid()) @db.Uuid
  caseId         String        @db.Uuid
  case           Case          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  /// Set when the work is about one document (a translation, typically).
  caseDocumentId String?       @db.Uuid
  caseDocument   CaseDocument? @relation(fields: [caseDocumentId], references: [id], onDelete: Cascade)

  type        WorkTaskType
  title       String
  description String?
  status      WorkTaskStatus @default(TODO)

  assigneeId  String? @db.Uuid
  assignee    User?   @relation("WorkTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById String? @db.Uuid
  createdBy   User?   @relation("WorkTaskCreator", fields: [createdById], references: [id], onDelete: SetNull)

  dueAt       DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([caseId])
  @@index([assigneeId, status])
  @@index([status, dueAt])
  @@map("work_tasks")
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

/// The single office visit that closes out every "эх хувиар авчрах" document at
/// once (gksedu.md §17.5, 1D-11) — the whole point is that it happens once.
model OfficeAppointment {
  id     String @id @default(uuid()) @db.Uuid
  caseId String @db.Uuid
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  scheduledAt DateTime
  status      AppointmentStatus @default(SCHEDULED)
  note        String?

  createdById String? @db.Uuid
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([caseId])
  @@index([scheduledAt])
  @@map("office_appointments")
}

/// One fired deadline reminder (1D-12). The row *is* the idempotency key —
/// the daily job may run many times a day and still send D-7 once. Actual
/// delivery (email/SMS/in-app) is wired in 1G-02; this records what is due.
model DocumentReminder {
  id             String       @id @default(uuid()) @db.Uuid
  caseDocumentId String       @db.Uuid
  caseDocument   CaseDocument @relation(fields: [caseDocumentId], references: [id], onDelete: Cascade)

  /// 7, 3 or 1 — days before `CaseDocument.dueAt`.
  offsetDays Int
  dueAt      DateTime
  createdAt  DateTime @default(now())

  @@unique([caseDocumentId, offsetDays])
  @@index([createdAt])
  @@map("document_reminders")
}

// ─────────────────────────────────────────────────────────────────────────────
// 1E — Application → school invoice → invitation (gksedu.md §7–§8).
// ─────────────────────────────────────────────────────────────────────────────

/// The 9 states of gksedu.md §7.
enum ApplicationStatus {
  PREPARING
  READY
  SUBMITTED
  UNDER_REVIEW
  ADDITIONAL_DOCS_REQUESTED
  INTERVIEW_SCHEDULED
  ACCEPTED
  REJECTED
  DEFERRED
}

enum ApplicationDecision {
  PASSED
  FAILED
  WAITLISTED
  DEFERRED
}

/// One case's submission to one university. GKS decides in two rounds, regular
/// brokerage in one — the difference lives in `ApplicationResult.round` (§7).
model Application {
  id     String @id @default(uuid()) @db.Uuid
  caseId String @unique @db.Uuid
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  /// Snapshot of the target at submission time; the case may be re-pointed later.
  universityId String?            @db.Uuid
  university   University?        @relation(fields: [universityId], references: [id], onDelete: SetNull)
  programId    String?            @db.Uuid
  program      UniversityProgram? @relation(fields: [programId], references: [id], onDelete: SetNull)
  intakeId     String?            @db.Uuid
  intake       IntakeTerm?        @relation(fields: [intakeId], references: [id], onDelete: SetNull)

  status          ApplicationStatus @default(PREPARING)
  /// The school's own reference for the submission.
  applicationNo   String?
  /// Элсэлтийн хураамж (§7 step 3) — paid to the school, not to GKS.
  admissionFeeKrw Decimal?          @db.Decimal(14, 2)

  submittedAt   DateTime?
  interviewAt   DateTime?
  interviewNote String?
  decidedAt     DateTime?
  note          String?

  results ApplicationResult[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([universityId])
  @@map("applications")
}

model ApplicationResult {
  id            String      @id @default(uuid()) @db.Uuid
  applicationId String      @db.Uuid
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  /// 1 for regular brokerage; GKS also carries a round 2 (§7).
  round     Int                 @default(1)
  decision  ApplicationDecision
  decidedAt DateTime
  note      String?

  recordedById String? @db.Uuid
  recordedBy   User?   @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([applicationId, round])
  @@map("application_results")
}

enum SchoolInvoiceStatus {
  DRAFT
  ISSUED
  PAID
  CONFIRMED_BY_SCHOOL
  CANCELLED
}

/// What the invoice is made of — a school bills tuition, dormitory and
/// insurance on one sheet (§8).
enum InvoiceItemKind {
  TUITION
  DORMITORY
  INSURANCE
  ADMISSION_FEE
  OTHER
}

/// The school's won-denominated bill, plus the MNT figure the client actually
/// transfers and the brokerage's transfer fee (§8).
model SchoolInvoice {
  id     String @id @default(uuid()) @db.Uuid
  caseId String @db.Uuid
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  status SchoolInvoiceStatus @default(DRAFT)

  totalKrw       Decimal @db.Decimal(14, 2)
  /// MNT per 1 KRW, snapshotted when the invoice is issued — a later rate move
  /// never rewrites what the client was told to pay.
  fxRate         Decimal @db.Decimal(12, 6)
  /// `totalKrw × fxRate`, stored so the figure shown to the client is stable.
  amountMnt      Decimal @db.Decimal(14, 2)
  /// Шилжүүлгийн үйлчилгээний шимтгэл (§8) — GKS's own fee, on top.
  transferFeeMnt Decimal @default(0) @db.Decimal(14, 2)

  dueAt              DateTime?
  paidAt             DateTime?
  receiptPath        String?
  /// Set once the school confirms the money landed.
  receivedBySchoolAt DateTime?
  note               String?

  items SchoolInvoiceItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([caseId])
  @@index([status])
  @@map("school_invoices")
}

model SchoolInvoiceItem {
  id        String        @id @default(uuid()) @db.Uuid
  invoiceId String        @db.Uuid
  invoice   SchoolInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  kind      InvoiceItemKind
  labelMn   String
  amountKrw Decimal         @db.Decimal(14, 2)
  sortOrder Int             @default(0)

  @@index([invoiceId])
  @@map("school_invoice_items")
}

/// The letter that ends the admission phase and opens the visa one (§8).
model Invitation {
  id     String @id @default(uuid()) @db.Uuid
  caseId String @unique @db.Uuid
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  number     String?
  issuedAt   DateTime?
  receivedAt DateTime  @default(now())
  filePath   String?
  note       String?

  uploadedById String? @db.Uuid
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("invitations")
}

/// Daily Mongolbank reference rate (1E-07). One row per currency per day; the
/// invoice snapshots the value rather than joining on it.
model FxRate {
  id       String   @id @default(uuid()) @db.Uuid
  currency String   @default("KRW")
  /// MNT per 1 unit of `currency`.
  rate     Decimal  @db.Decimal(12, 6)
  date     DateTime @db.Date
  source   String   @default("mongolbank")

  createdAt DateTime @default(now())

  @@unique([currency, date])
  @@index([currency, date])
  @@map("fx_rates")
}

// ─────────────────────────────────────────────────────────────────────────────
// 1F — Visa and pre-departure (gksedu.md §10–§11).
// ─────────────────────────────────────────────────────────────────────────────

/// The 8 states of gksedu.md §10.
enum VisaStatus {
  COLLECTING
  REVIEWING
  READY
  SUBMITTED
  ADDITIONAL_DOCS_REQUESTED
  APPROVED
  REJECTED
  REAPPLY
}

enum VisaType {
  /// Degree study.
  D2
  /// Language training.
  D4
  OTHER
}

/// The client applies in person; GKS prepares every paper behind it (§10).
model VisaCase {
  id     String @id @default(uuid()) @db.Uuid
  caseId String @unique @db.Uuid
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  status   VisaStatus @default(COLLECTING)
  visaType VisaType

  /// Consulate appointment (§10 "цаг захиалах").
  appointmentAt   DateTime?
  submittedAt     DateTime?
  decidedAt       DateTime?
  visaNumber      String?
  expiresAt       DateTime?
  rejectionReason String?
  note            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("visa_cases")
}

/// Reusable checklist row seeded from §11 and cloned into every plan (1F-07).
model DepartureChecklistTemplate {
  code          String  @id
  titleMn       String
  descriptionMn String?
  guideUrl      String?
  videoUrl      String?
  /// How many days before departure this should be done; drives `dueAt`.
  offsetDays    Int?
  sortOrder     Int     @default(0)
  isActive      Boolean @default(true)

  items DepartureChecklistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("departure_checklist_templates")
}

model DeparturePlan {
  id     String @id @default(uuid()) @db.Uuid
  caseId String @unique @db.Uuid
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  departureAt     DateTime?
  flightNo        String?
  arrivalAt       DateTime?
  /// Сургуулийн тосох үйлчилгээ (§11).
  pickupRequested Boolean   @default(false)
  dormitoryInfo   String?
  emergencyNote   String?
  note            String?

  items DepartureChecklistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("departure_plans")
}

model DepartureChecklistItem {
  id     String        @id @default(uuid()) @db.Uuid
  planId String        @db.Uuid
  plan   DeparturePlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  /// Null once the seed row it came from is retired, or for a hand-added item.
  templateCode String?                     @db.VarChar(64)
  template     DepartureChecklistTemplate? @relation(fields: [templateCode], references: [code], onDelete: SetNull)

  titleMn       String
  descriptionMn String?
  guideUrl      String?
  videoUrl      String?
  dueAt         DateTime?
  isDone        Boolean   @default(false)
  doneAt        DateTime?
  sortOrder     Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([planId, templateCode])
  @@index([planId])
  @@map("departure_checklist_items")
}
