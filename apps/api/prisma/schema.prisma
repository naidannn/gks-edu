// Prisma schema — PostgreSQL 17 with the pgvector extension.
//
// Prisma 7 keeps connection URLs out of this file; they live in
// `prisma.config.ts` (CLI) and in the driver adapter (`PrismaService`).
//
// `Unsupported("vector(1536)")` maps the pgvector column type: Prisma tracks it
// in migrations but cannot read or write it through the typed client, so
// embeddings go through raw queries in `src/modules/vector/vector.service.ts`.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  // NestJS 12 is ESM-only, so the client is generated as ESM too.
  moduleFormat    = "esm"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  // On Supabase these already exist in the `extensions` schema, so the
  // generated `CREATE EXTENSION IF NOT EXISTS` is a no-op there.
  extensions = [vector, pg_trgm]
}

enum Role {
  USER
  ADMIN
  /// CRM staff: leads, contracts, cases (0-07).
  CONSULTANT
  /// Document/material review staff (0-07) — no CRM access by default.
  DOC_OFFICER
}

model User {
  id       String  @id @default(uuid()) @db.Uuid
  /// Null for a staff-created client who has not claimed a portal login yet (1B-14).
  email    String? @unique
  /// Null until the account is claimed — such a row cannot pass `login`.
  password String?
  name     String?
  /// Needed for SMS-OTP contract signing (1C-08) — collected at accept-contract time if unset.
  phone    String?
  role     Role    @default(USER)
  isActive Boolean @default(true)

  /// Google account subject (`sub`) — set the first time the user signs in with
  /// Google. A row can carry both this and `password`; either one logs them in.
  googleId String? @unique

  /// 1B-17 — invitation to claim a staff-created account. SHA-256 of the
  /// emailed token; the raw value only ever exists in the invite link.
  claimTokenHash      String?   @unique
  claimTokenExpiresAt DateTime?
  claimedAt           DateTime?

  /// Password reset. Same shape as the claim token — SHA-256 of the value that
  /// only ever exists inside the emailed link — but short-lived, and it never
  /// signs anyone in on its own.
  passwordResetTokenHash String?   @unique
  passwordResetExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens     RefreshToken[]
  documents         Document[]
  leads             Lead[]
  assignedLeads     Lead[]            @relation("LeadAssignee")
  leadActivities    LeadActivity[]
  posts             Post[]
  savedUniversities SavedUniversity[]

  client          Client?
  assignedClients Client[] @relation("ClientConsultant")
  createdClients  Client[] @relation("ClientCreatedBy")

  cases                     Case[]
  assignedCasesAsConsultant Case[]           @relation("CaseConsultant")
  assignedCasesAsDocOfficer Case[]           @relation("CaseDocOfficer")
  caseTransitions           CaseTransition[]
  contracts                 Contract[]
  payments                  Payment[]

  caseConditions      CaseConditions[]
  documentFiles       DocumentFile[]
  documentReviewNotes DocumentReviewNote[]
  assignedWorkTasks   WorkTask[]           @relation("WorkTaskAssignee")
  createdWorkTasks    WorkTask[]           @relation("WorkTaskCreator")
  officeAppointments  OfficeAppointment[]
  applicationResults  ApplicationResult[]
  invitations         Invitation[]

  auditLogs               AuditLog[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  gksRankingConfigs       GksRankingConfig[]

  conversations         Conversation[] @relation("ConversationClient")
  assignedConversations Conversation[] @relation("ConversationAssignee")
  resolvedConversations Conversation[] @relation("ConversationResolver")
  messages              Message[]

  verifiedIntakes     IntakeTerm[]
  admissionConfigs    AdmissionConfig[]
  intakeResearchRuns  IntakeResearchRun[]
  verifiedPrograms    UniversityProgram[]
  programResearchRuns ProgramResearchRun[]

  @@index([createdAt])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  /// SHA-256 of the issued refresh token — the raw token is never stored.
  tokenHash String    @unique
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Document {
  id        String   @id @default(uuid()) @db.Uuid
  title     String
  source    String?
  metadata  Json     @default("{}")
  authorId  String?  @db.Uuid
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chunks DocumentChunk[]

  @@index([authorId])
  @@map("documents")
}

model DocumentChunk {
  id         String                       @id @default(uuid()) @db.Uuid
  documentId String                       @db.Uuid
  document   Document                     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  /// Position of this chunk inside the parent document.
  chunkIndex Int
  content    String
  /// pgvector column. Keep the dimension in sync with EMBEDDING_DIMENSIONS.
  embedding  Unsupported("vector(1536)")?
  createdAt  DateTime                     @default(now())

  @@unique([documentId, chunkIndex])
  @@index([documentId])
  @@map("document_chunks")
}

// ─────────────────────────────────────────────────────────────────────────────
// University reference data (ARCHITECTURE.md §3)
//
// Imported from /Users/user/korean-universities-data by `prisma/import-universities.ts`.
// Fields the dataset cannot know — whether the school takes Mongolian students,
// agent contract terms, internal notes — are edited by staff and the importer
// never overwrites them.
// ─────────────────────────────────────────────────────────────────────────────

enum UniversityType {
  NATIONAL
  PUBLIC
  PRIVATE
}

enum AgentContractStatus {
  NONE
  IN_TALKS
  SIGNED
  EXPIRED
}

/// A brokerage service line (ARCHITECTURE.md §5).
enum ServiceType {
  LANGUAGE_PREP
  BACHELOR
  MASTER
  PHD
  GKS_SCHOLARSHIP
}

/// What a university actually teaches — GKS_SCHOLARSHIP is a service, not a level.
enum ProgramLevel {
  LANGUAGE_PREP
  BACHELOR
  MASTER
  PHD
}

/// Staff-controlled lifecycle of an intake round. The *phase* a visitor sees
/// (нээгдээгүй / нээлттэй / манайх хаагдсан / хаагдсан) is derived from the
/// dates in `intake-deadline.ts` — this enum only says what staff decided.
enum IntakeStatus {
  /// Draft: entered but not published, invisible on every public payload.
  PLANNED
  OPEN
  CLOSED
  /// The school is not running this round after all.
  CANCELLED
}

/// Where an intake's dates came from. `AI_ASSISTED` means a human accepted a
/// Gemini research candidate — the research itself never writes an intake.
enum IntakeSource {
  MANUAL
  AI_ASSISTED
  IMPORTED
}

/// Where a programme's tuition and requirements came from. Same three values as
/// `IntakeSource` and the same rule behind them: `AI_ASSISTED` means a human
/// read a research candidate and pressed save — the research never writes.
enum ProgramSource {
  MANUAL
  AI_ASSISTED
  IMPORTED
}

/// What language a programme is actually taught in. The filter a Mongolian
/// applicant with no TOPIK asks for first.
enum InstructionLanguage {
  KOREAN
  ENGLISH
  /// Some courses in each — the school calls it a "track" or a "dual" option.
  KOREAN_ENGLISH
}

model University {
  id     String         @id @default(uuid()) @db.Uuid
  slug   String         @unique
  nameKo String
  nameEn String
  nameMn String
  type   UniversityType

  foundedYear Int?
  cityEn      String
  cityMn      String
  regionEn    String
  regionMn    String
  address     String?
  lat         Float?
  lon         Float?

  logoPath  String?
  coverPath String?

  shortIntroMn          String?
  detailedIntroMn       String?
  studentsTotal         Int?
  /// Unfilled by design in the source dataset — render null as "мэдээлэл шинэчлэгдэж байна".
  internationalStudents Int?
  mongolianStudents     Int?
  numCampuses           Int?
  campusInfo            String?
  distanceFromSeoulKm   Float?
  travelTimeFromSeoul   String?
  /// Nearest metro/bus access — unfilled by design in the source dataset.
  nearestTransit        String?
  /// 3–6 editorial sentences in Mongolian; a human verifies these before launch.
  advantages            String[] @default([])

  /// Regional estimate: tier, monthly min/max, breakdown, isEstimate.
  livingCost Json?
  /// Usually null — the UI must render that as "мэдээлэл шинэчлэгдэж байна", not 0.
  dormitory  Json?
  /// officialWebsite, wikipedia, wikidata.
  links      Json  @default("{}")
  /// Per-field provenance: verified / editorial / estimated.
  quality    Json  @default("{}")

  // --- Ranking (1A-28 … 1A-31, ARCHITECTURE.md §3.1) ---
  /// Times Higher Education "South Korea Rank" — the base rank. Ties share a
  /// number (three schools sit at 8), and only 41 of the 135 schools appear at
  /// all; `null` means "рэйтингд ороогүй", never "worst".
  theKoreaRank Int?
  /// THE world rank as published — "=58", "251-300", "1501+". A display string
  /// on purpose: a band is not a number and must not be sorted as one.
  theWorldRank String?
  /// Which edition the two columns above came from, e.g. 2026.
  theRankYear  Int?

  /// Our own 0-100 recommendation score. Written only by `GksRankingService`.
  gksScore      Float?
  /// Dense rank over `gksScore`, 1 = shown first. The default catalogue order.
  gksRank       Int?
  /// Staff thumb on the scale, in score points (-25 … +25) — the one part of
  /// the score a human sets by hand.
  gksRankBoost  Float     @default(0)
  /// Per-component contributions of the last run, so the admin screen can say
  /// why a school sits where it does: { base, partnership, fit, demand, practical }.
  gksScoreParts Json?
  gksScoredAt   DateTime?

  // --- Staff-maintained; never touched by the importer ---
  acceptsLanguagePrep Boolean             @default(false)
  acceptsFromMongolia Boolean             @default(true)
  isGksEligible       Boolean             @default(false)
  agentContractStatus AgentContractStatus @default(NONE)
  /// Internal — commission terms, never exposed on public endpoints.
  commissionNote      String?
  /// Internal — staff notes, never exposed on public endpoints.
  internalNote        String?
  isPublished         Boolean             @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  programs UniversityProgram[]
  intakes  IntakeTerm[]
  savedBy  SavedUniversity[]
  cases    Case[]
  clients  Client[]

  requirementRules    RequirementRule[]
  applications        Application[]
  researchRuns        IntakeResearchRun[]
  programResearchRuns ProgramResearchRun[]

  @@index([isPublished])
  @@index([regionEn])
  @@index([type])
  @@index([gksRank])
  @@index([theKoreaRank])
  @@map("universities")
}

/// Weights behind the GKS ranking (1A-29). One row — `id` is pinned to
/// "default" so there can only ever be one. Weights are business configuration,
/// not constants: the office retunes them without a deploy, exactly like
/// `ServicePricing` (CLAUDE.md, gksedu.md §5.4).
model GksRankingConfig {
  id String @id @default("default")

  /// The five component weights. They need not sum to 100 — the score is
  /// normalised by their total, so raising one lowers the others' share.
  weightBaseRank    Float @default(40)
  weightPartnership Float @default(20)
  weightFit         Float @default(15)
  weightDemand      Float @default(15)
  weightPractical   Float @default(10)

  /// Base-component score for a school THE does not rank. Neutral by design:
  /// equal to the score of the last ranked school, so "unranked" costs a school
  /// nothing beyond the schools that are actually ranked above it.
  unrankedBaseScore Float @default(45)

  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("gks_ranking_config")
}

/// The canonical name of a subject, and the reason "маркетинг" can be one
/// question rather than 135 (ARCHITECTURE.md §3.3).
///
/// Every school words the same subject differently — 경영학과 마케팅전공,
/// Department of Marketing, "Маркетинг менежмент" — so a programme keeps the
/// school's own wording in `UniversityProgram.nameMn/nameEn/nameKo` and is
/// *filed* under one of these. Search and the public filters run on the
/// canonical row; the school's wording is what gets displayed.
///
/// Two levels deep, no more: a group ("Бизнес, эдийн засаг") and the subjects
/// inside it. `aliases` is how staff teach the matcher a new school's naming —
/// adding one and re-running the match is the whole maintenance loop.
model StudyField {
  id     String  @id @default(uuid()) @db.Uuid
  slug   String  @unique
  nameMn String
  nameEn String
  nameKo String?

  /// Every other wording seen for this subject, in any of the three languages.
  /// `study-field.matcher.ts` normalises against these — a Korean entry needs
  /// no 학과/학부/전공 suffix, the matcher strips those.
  aliases String[] @default([])

  /// The broad group this subject sits in. Null on a group itself.
  parentId String?      @db.Uuid
  parent   StudyField?  @relation("StudyFieldTree", fields: [parentId], references: [id], onDelete: SetNull)
  children StudyField[] @relation("StudyFieldTree")

  /// Order inside its group on the filter panel; ties fall back to `nameMn`.
  sortOrder Int     @default(100)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  programs UniversityProgram[]

  @@index([parentId])
  @@index([isActive])
  @@map("study_fields")
}

/// One programme (анги) a university runs, with what it costs.
///
/// Tuition is the field this table exists for, and it is quoted the way Korean
/// schools quote it: per semester (한 학기), in KRW, with the one-off entrance
/// fee (입학금) separate. `tuitionYear` says which academic year the number was
/// read off — a price with no year on it is the one that gets quoted to a
/// client two years stale.
model UniversityProgram {
  id           String       @id @default(uuid()) @db.Uuid
  universityId String       @db.Uuid
  university   University   @relation(fields: [universityId], references: [id], onDelete: Cascade)
  level        ProgramLevel

  /// The school's own wording, kept as the school writes it.
  nameMn String
  nameEn String?
  nameKo String?

  /// The canonical subject this programme is filed under — what makes
  /// "бүх сургуулийн маркетинг" one query. Null = not yet classified; the
  /// admin screen lists those separately so they do not quietly go missing.
  studyFieldId String?     @db.Uuid
  studyField   StudyField? @relation(fields: [studyFieldId], references: [id], onDelete: SetNull)

  /// The school's own college/faculty, as it appears in the prospectus
  /// (경영대학, College of Engineering). Free text next to the canonical field,
  /// not a substitute for it.
  faculty       String?
  durationYears Float?

  // --- Tuition (the reason this module exists) ---
  /// Per semester, KRW. The number Korean schools actually publish.
  tuitionPerTermKrw     Int?
  /// Per year, KRW. Usually `tuitionPerTermKrw × 2`, but entered, never derived —
  /// some programmes run three terms and some publish only the annual figure.
  tuitionPerYearKrw     Int?
  /// 입학금 — the one-off entrance fee, paid in the first semester only.
  admissionFeeKrw       Int?
  /// The academic year these figures were read off. Null means unknown, which
  /// the UI must show as "мэдээлэл шинэчлэгдэж байна" rather than as current.
  tuitionYear           Int?
  /// Best scholarship rate a foreign student can realistically get, in percent.
  /// Korean schools discount 30-70% for international applicants and it moves
  /// the real cost more than the sticker price does.
  scholarshipMaxPercent Int?
  /// What that discount depends on, in Mongolian — TOPIK level, grades, quota.
  scholarshipNote       String?

  // --- Admission requirements ---
  /// Minimum TOPIK level required for admission (1–6).
  topikLevel           Int?
  ieltsScore           Float?
  otherRequirements    String?
  language             InstructionLanguage @default(KOREAN)
  /// False for a programme that does not take foreign students at all — it
  /// stays in the catalogue so nobody re-researches it every quarter.
  acceptsInternational Boolean             @default(true)

  // --- Provenance, same contract as `IntakeTerm` ---
  sourceUrl    String?
  sourceType   ProgramSource @default(MANUAL)
  /// Who last checked this against the school, and when. No `verifiedAt` means
  /// unconfirmed, and the admin list flags it.
  verifiedAt   DateTime?
  verifiedById String?       @db.Uuid
  verifiedBy   User?         @relation(fields: [verifiedById], references: [id], onDelete: SetNull)
  /// Internal — staff notes, never exposed on a public endpoint.
  internalNote String?

  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cases           Case[]
  applications    Application[]
  intakeOverrides IntakeProgramOverride[]

  @@unique([universityId, level, nameMn])
  @@index([universityId])
  @@index([level])
  @@index([studyFieldId])
  @@index([tuitionPerYearKrw])
  @@map("university_programs")
}

/// One run of "look this school's programmes and tuition up online" — the same
/// arrangement as `IntakeResearchRun`, and the same hard rule: a run produces
/// *candidates*, staff tick the ones they believe, and the save is a human's.
/// Nothing here becomes a `UniversityProgram` on its own.
model ProgramResearchRun {
  id           String     @id @default(uuid()) @db.Uuid
  universityId String     @db.Uuid
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  /// Empty = every level.
  levels ProgramLevel[] @default([])
  /// Academic year the tuition was asked for.
  year   Int

  status IntakeResearchStatus @default(QUEUED)
  model  String

  /// Validated `ProgramCandidate[]` — the shape lives in `packages/shared`.
  candidates  Json?
  /// Grounding citations Gemini returned, so staff can check the source.
  sources     String[] @default([])
  /// The unparsed model output, kept for debugging a failed parse.
  rawResponse String?
  error       String?

  promptTokens   Int?
  responseTokens Int?

  /// How many candidates from this run a human went on to save.
  acceptedCount Int @default(0)

  startedAt  DateTime?
  finishedAt DateTime?

  requestedById String? @db.Uuid
  requestedBy   User?   @relation(fields: [requestedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([universityId, createdAt])
  @@index([status])
  @@map("program_research_runs")
}

/// Intake round. Language prep runs four a year, degree programmes two (§4.1, §4.2).
///
/// Four dates, and confusing two of them is the expensive mistake:
///   `openAt`              — the school starts accepting applications
///   `applicationDeadline` — the SCHOOL's last day (their published date)
///   `internalDeadline`    — OURS: `applicationDeadline − AdmissionConfig.internalLeadDays`
///                           (7 days by default), the date every case is driven to
///   `classStartDate`      — classes begin, i.e. when the student flies out
///
/// One row covers a whole level at a school. When a single programme runs to a
/// different calendar, `IntakeProgramOverride` overrides the dates for it.
model IntakeTerm {
  id           String       @id @default(uuid()) @db.Uuid
  universityId String       @db.Uuid
  university   University   @relation(fields: [universityId], references: [id], onDelete: Cascade)
  level        ProgramLevel
  year         Int
  /// 3, 6, 9 or 12 — the Korean academic intake months.
  month        Int

  /// The school opens its application window.
  openAt                   DateTime? @db.Date
  /// The school's own last day for documents.
  applicationDeadline      DateTime?
  /// Our last day — `applicationDeadline` minus `AdmissionConfig.internalLeadDays`.
  /// Recomputed whenever `applicationDeadline` or the config changes, UNLESS a
  /// human typed it, in which case `internalDeadlineIsManual` freezes it.
  internalDeadline         DateTime?
  /// True once staff set `internalDeadline` by hand; the automatic recompute
  /// then leaves this row alone.
  internalDeadlineIsManual Boolean   @default(false)
  /// First day of classes — the month above says which intake, this says the day.
  classStartDate           DateTime? @db.Date
  /// When the school publishes its decision.
  resultAnnouncedAt        DateTime? @db.Date

  /// Seats in this round, when the school publishes a number.
  quota           Int?
  /// Элсэлтийн хураамж — paid to the school, in KRW.
  admissionFeeKrw Int?
  /// Anything this round asks for beyond the standard document set.
  requirementNote String?

  status IntakeStatus @default(PLANNED)
  note   String?

  /// The school's own announcement page these dates were read off.
  sourceUrl    String?
  sourceType   IntakeSource @default(MANUAL)
  /// Who last checked these dates against the school, and when. A row with no
  /// `verifiedAt` is unconfirmed — the admin list flags it.
  verifiedAt   DateTime?
  verifiedById String?      @db.Uuid
  verifiedBy   User?        @relation(fields: [verifiedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cases            Case[]
  clients          Client[]
  applications     Application[]
  programOverrides IntakeProgramOverride[]

  @@unique([universityId, level, year, month])
  @@index([universityId])
  @@index([year, month])
  @@index([status, internalDeadline])
  @@index([internalDeadline])
  @@map("intake_terms")
}

/// One programme inside an intake round that runs to a different calendar.
/// Kept out of `IntakeTerm` on purpose: the term stays the thing a `Case`
/// points at, and its `@@unique(universityId, level, year, month)` stays whole.
/// Resolution is always "override ?? term", in `intake-deadline.ts`.
model IntakeProgramOverride {
  id        String            @id @default(uuid()) @db.Uuid
  intakeId  String            @db.Uuid
  intake    IntakeTerm        @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  programId String            @db.Uuid
  program   UniversityProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  /// Null on any of these means "use the term's value".
  openAt                   DateTime? @db.Date
  applicationDeadline      DateTime?
  internalDeadline         DateTime?
  internalDeadlineIsManual Boolean   @default(false)
  classStartDate           DateTime? @db.Date
  quota                    Int?
  note                     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([intakeId, programId])
  @@index([programId])
  @@map("intake_program_overrides")
}

/// Admissions business configuration — one row, `id` pinned to "default".
/// Business configuration, never constants: the office retunes the lead time
/// and the reminder ladder without a deploy, exactly like `ServicePricing`
/// and `GksRankingConfig` (CLAUDE.md, gksedu.md §5.4).
model AdmissionConfig {
  id String @id @default("default")

  /// How many days before the school's deadline our own deadline falls.
  /// The office's current rule is 7; it is a value, not a constant.
  internalLeadDays Int @default(7)

  /// Days before `internalDeadline` a client is reminded.
  clientReminderOffsets  Int[] @default([30, 14, 7, 3, 1])
  /// Days before `internalDeadline` the assigned staff are warned about a case
  /// whose documents are still short.
  staffReminderOffsets   Int[] @default([21, 14, 7, 3, 1])
  /// Below this document-readiness percentage a case counts as at risk.
  riskReadinessThreshold Int   @default(80)

  /// Gemini model the "research this online" button runs against.
  researchModel String @default("gemini-3.1-flash-lite")

  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("admission_config")
}

enum IntakeResearchStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

/// One run of "look this school's intake dates up online" (Gemini + Google
/// Search grounding). The result is a *proposal*: staff read the candidates,
/// drop them into the form and save. Nothing here ever becomes an
/// `IntakeTerm` on its own.
model IntakeResearchRun {
  id           String     @id @default(uuid()) @db.Uuid
  universityId String     @db.Uuid
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  /// Empty = every level.
  levels ProgramLevel[] @default([])
  year   Int

  status IntakeResearchStatus @default(QUEUED)
  model  String

  /// Validated `IntakeCandidate[]` — the shape lives in `packages/shared`.
  candidates  Json?
  /// Grounding citations Gemini returned, so staff can check the source.
  sources     String[] @default([])
  /// The unparsed model output, kept for debugging a failed parse.
  rawResponse String?
  error       String?

  promptTokens   Int?
  responseTokens Int?

  startedAt  DateTime?
  finishedAt DateTime?

  requestedById String? @db.Uuid
  requestedBy   User?   @relation(fields: [requestedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([universityId, createdAt])
  @@index([status])
  @@map("intake_research_runs")
}

// ─────────────────────────────────────────────────────────────────────────────
// CRM — leads (ARCHITECTURE.md §4, gksedu.md §5.2)
// ─────────────────────────────────────────────────────────────────────────────

enum EducationLevel {
  SECONDARY_SCHOOL
  VOCATIONAL
  BACHELOR
  MASTER
  PHD
}

enum LeadSource {
  WEBSITE
  AI_CHAT
  PHONE
  SOCIAL
  OFFICE
  /// "Хэлний сургалтын төв" — the only trace the deferred MIRAE module leaves here.
  LANGUAGE_CENTER
  REFERRAL
  OTHER
}

enum LeadStage {
  NEW
  CONTACTED
  CONSULTED
  PROPOSAL_SENT
  CONTRACT_PENDING
  WON
  LOST
}

enum LeadActivityType {
  NOTE
  CALL
  MEETING
  MESSAGE
  EMAIL
  CHAT
  STAGE_CHANGE
}

model Lead {
  id     String  @id @default(uuid()) @db.Uuid
  /// Set once the lead registers an account.
  userId String? @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  firstName String
  lastName  String
  phone     String
  email     String?

  age            Int?
  educationLevel EducationLevel?
  gpa            Float?
  /// gksedu.md §24 question 1 — the GPA scale in use is still undecided.
  gpaScale       String?
  koreanLevel    String?
  englishLevel   String?

  interestedServices      ServiceType[] @default([])
  interestedUniversityIds String[]      @default([]) @db.Uuid
  interestedMajor         String?
  plannedIntakeId         String?       @db.Uuid

  source LeadSource
  stage  LeadStage  @default(NEW)

  assignedToId   String?   @db.Uuid
  assignedTo     User?     @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  nextContactAt  DateTime?
  /// gksedu.md §15.1 "гэрээ болох магадлал", 0–100.
  winProbability Int?
  lostReason     String?

  note String?
  /// Marketing attribution: utm_source/medium/campaign, referrer, landing page.
  utm  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities    LeadActivity[]
  workTasks     WorkTask[]
  notifications Notification[]
  /// Set once staff convert this lead into a client (1B-10) — the lead row stays as history.
  client        Client?

  /// 1B-09 — set when this row was merged into another lead; kept as history.
  mergedIntoId String?   @db.Uuid
  mergedInto   Lead?     @relation("LeadMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom   Lead[]    @relation("LeadMerge")
  mergedAt     DateTime?

  @@index([stage])
  @@index([assignedToId])
  @@index([source])
  @@index([createdAt])
  @@index([phone])
  @@index([email])
  @@index([assignedToId, nextContactAt])
  @@map("leads")
}

model LeadActivity {
  id     String           @id @default(uuid()) @db.Uuid
  leadId String           @db.Uuid
  lead   Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type   LeadActivityType
  body   String?
  /// Type-specific payload: call duration, previous/next stage, channel …
  meta   Json             @default("{}")

  /// Null for system-generated entries.
  actorId String? @db.Uuid
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([leadId, occurredAt])
  @@map("lead_activities")
}

// ─────────────────────────────────────────────────────────────────────────────
// Client (гэрээт харилцагч) — 1B-14.
//
// A `Lead` is a pre-contract enquiry; a `Client` is a person the office has
// taken on. The two are deliberately separate tables: converting a lead copies
// what is still true into a client row and leaves the lead as sales history.
//
// A client is always backed by a `User` row, because `Case`, `Contract` and
// `Payment` all hang off `userId`. That row carries no email/password until the
// client claims a portal login — staff-created clients never get a fake account.
// ─────────────────────────────────────────────────────────────────────────────

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ClientStatus {
  /// In an active service cycle, or waiting to start one.
  ACTIVE
  /// No live case; kept for history and repeat business.
  INACTIVE
  ARCHIVED
}

model Client {
  id     String  @id @default(uuid()) @db.Uuid
  /// Human-readable, e.g. KH-2026-0042.
  code   String  @unique
  /// The account rows Case/Contract/Payment point at — created together with the client.
  userId String  @unique @db.Uuid
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The enquiry this client was converted from, if any (1B-10).
  leadId String? @unique @db.Uuid
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  // ── Identity — what the brokerage contract is written against (§6.2).
  lastName       String
  firstName      String
  birthDate      DateTime @db.Date
  /// Регистрийн дугаар — 2 Cyrillic letters + 8 digits, validated in the DTO.
  registerNumber String   @unique
  gender         Gender?
  phone          String
  phoneAlt       String?
  email          String?
  address        String?

  // ── Guardian (төлөөлөн гэрээ байгуулагч) — required while the client is a
  //    minor on the contract date; kept afterwards as the signed record.
  guardianLastName       String?
  guardianFirstName      String?
  guardianRegisterNumber String?
  guardianPhone          String?
  /// Free text: "Эх", "Эцэг", "Асран хамгаалагч" …
  guardianRelation       String?

  // ── Academic background carried over from the lead, kept editable here.
  educationLevel EducationLevel?
  schoolName     String?
  gpa            Float?
  /// gksedu.md §24 question 1 — the GPA scale in use is still undecided.
  gpaScale       String?
  koreanLevel    String?
  englishLevel   String?
  passportNumber String?
  passportExpiry DateTime?

  // ── What the client signed up for. The authoritative per-service state lives
  //    on `Case`; these are the choice made at registration time.
  primaryServiceType ServiceType
  targetUniversityId String?     @db.Uuid
  targetUniversity   University? @relation(fields: [targetUniversityId], references: [id], onDelete: SetNull)
  targetMajor        String?
  plannedIntakeId    String?     @db.Uuid
  plannedIntake      IntakeTerm? @relation(fields: [plannedIntakeId], references: [id], onDelete: SetNull)

  source LeadSource   @default(OFFICE)
  status ClientStatus @default(ACTIVE)
  note   String?

  assignedConsultantId String? @db.Uuid
  assignedConsultant   User?   @relation("ClientConsultant", fields: [assignedConsultantId], references: [id], onDelete: SetNull)
  createdById          String? @db.Uuid
  createdBy            User?   @relation("ClientCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([assignedConsultantId])
  @@index([primaryServiceType])
  @@index([createdAt])
  @@index([phone])
  @@index([lastName, firstName])
  @@map("clients")
}

// ─────────────────────────────────────────────────────────────────────────────
// Saved universities (1A-18) — a logged-in visitor's shortlist.
// ─────────────────────────────────────────────────────────────────────────────

model SavedUniversity {
  id           String     @id @default(uuid()) @db.Uuid
  userId       String     @db.Uuid
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  universityId String     @db.Uuid
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, universityId])
  @@index([userId])
  @@map("saved_universities")
}

// ─────────────────────────────────────────────────────────────────────────────
// Content — blog/news and FAQ (1A-11, gksedu.md marketing site scope).
// ─────────────────────────────────────────────────────────────────────────────

enum PostStatus {
  DRAFT
  PUBLISHED
}

model Post {
  id      String  @id @default(uuid()) @db.Uuid
  slug    String  @unique
  title   String
  /// Short teaser shown on the list page and used as the OG/meta description fallback.
  excerpt String?
  /// Rendered as sanitized HTML on the frontend (ARCHITECTURE.md content pipeline).
  content String

  coverImagePath String?
  status         PostStatus @default(DRAFT)
  publishedAt    DateTime?

  authorId String? @db.Uuid
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  seoTitle       String?
  seoDescription String?
  tags           String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
  @@map("posts")
}

/// Content bucket a FAQ entry belongs to — labels live on the frontend (CLAUDE.md).
enum FaqCategory {
  GENERAL
  SERVICES
  PRICING
  DOCUMENTS
  VISA
  LANGUAGE_CENTER
}

model FaqItem {
  id       String      @id @default(uuid()) @db.Uuid
  category FaqCategory
  question String
  answer   String

  /// Manual sort order within a category; lower shows first.
  order       Int     @default(0)
  isPublished Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, order])
  @@map("faq_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// 1C — Contract & QPay payment (ARCHITECTURE.md §5, §6; gksedu.md §5.4, §5.5)
//
// `CaseFlowDefinition` carries the allowed stage graph as data (not a hardcoded
// map like `LEAD_STAGE_TRANSITIONS`) because the two service families — regular
// brokerage vs. GKS scholarship — order `BALANCE_PAID` differently around the
// visa step (§9, ARCHITECTURE.md §18 question 6 is still open on which order is
// authoritative; both are supported via `CaseFlowDefinition` rows per
// `serviceType`).
// ─────────────────────────────────────────────────────────────────────────────

enum PrepaymentMode {
  PERCENT
  FIXED
}

enum BalanceTrigger {
  AFTER_VISA_APPROVED
  AFTER_SCHOLARSHIP_RESULT
}

/// Union of both service families' stages (§5) plus escapes reachable from anywhere.
enum CaseStage {
  CONTRACT_DRAFT
  CONTRACT_SIGNED
  PREPAYMENT_PAID
  DOCUMENTS
  APPLICATION_SUBMITTED
  // Regular brokerage (language prep / BA / MA / PhD) only.
  ADMITTED
  TUITION_INVOICED
  INVITATION_RECEIVED
  // GKS scholarship only.
  GKS_ROUND1_PASSED
  GKS_ROUND2_PASSED
  VISA
  VISA_APPROVED
  BALANCE_PAID
  /// Regular brokerage language-prep only (gksedu.md §5.4 "Барьцааны гэрээ").
  COLLATERAL_CONTRACT
  PRE_DEPARTURE
  DEPARTED
  COMPLETED
  // Reachable from any stage.
  ON_HOLD
  CANCELLED
  REJECTED
}

enum ContractType {
  ELECTRONIC
  PHYSICAL
}

enum ContractStatus {
  DRAFT
  SENT
  SIGNED
  ACTIVE
  COMPLETED
  TERMINATED
}

enum PaymentKind {
  PREPAYMENT
  BALANCE
  SCHOOL_TUITION
  TRANSFER_FEE
  EXTRA_SERVICE
  REFUND
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

/// Payment channel (gksedu.md §24 q5). QPay is the self-service one; the other three
/// only ever appear on a row a staff member registered by hand (1C-27).
enum PaymentMethod {
  QPAY
  BANK_TRANSFER
  CARD
  CASH
}

/// Versioned service pricing (gksedu.md §5.4) — admin-configurable, never a constant.
model ServicePricing {
  id              String         @id @default(uuid()) @db.Uuid
  serviceType     ServiceType
  totalAmount     Decimal        @db.Decimal(14, 2)
  prepaymentMode  PrepaymentMode
  prepaymentValue Decimal        @db.Decimal(14, 2)
  balanceTrigger  BalanceTrigger
  effectiveFrom   DateTime
  /// Null = currently active.
  effectiveTo     DateTime?
  createdAt       DateTime       @default(now())

  @@index([serviceType, effectiveFrom])
  @@map("service_pricing")
}

/// One user × one service × one target university × one intake (§5).
model Case {
  id     String @id @default(uuid()) @db.Uuid
  /// Human-readable, e.g. GKS-2026-0417.
  code   String @unique
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  serviceType  ServiceType
  universityId String?            @db.Uuid
  university   University?        @relation(fields: [universityId], references: [id], onDelete: SetNull)
  programId    String?            @db.Uuid
  program      UniversityProgram? @relation(fields: [programId], references: [id], onDelete: SetNull)
  intakeId     String?            @db.Uuid
  intake       IntakeTerm?        @relation(fields: [intakeId], references: [id], onDelete: SetNull)

  stage CaseStage @default(CONTRACT_DRAFT)

  assignedConsultantId String? @db.Uuid
  assignedConsultant   User?   @relation("CaseConsultant", fields: [assignedConsultantId], references: [id], onDelete: SetNull)
  assignedDocOfficerId String? @db.Uuid
  assignedDocOfficer   User?   @relation("CaseDocOfficer", fields: [assignedDocOfficerId], references: [id], onDelete: SetNull)

  contract    Contract?
  payments    Payment[]
  transitions CaseTransition[]

  conditions     CaseConditions?
  documents      CaseDocument[]
  workTasks      WorkTask[]
  appointments   OfficeAppointment[]
  application    Application?
  schoolInvoices SchoolInvoice[]
  invitation     Invitation?
  visaCase       VisaCase?
  departurePlan  DeparturePlan?
  notifications  Notification[]
  conversations  Conversation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([stage])
  @@index([assignedConsultantId])
  @@index([assignedDocOfficerId])
  @@map("cases")
}

model CaseTransition {
  id        String    @id @default(uuid()) @db.Uuid
  caseId    String    @db.Uuid
  case      Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  fromStage CaseStage
  toStage   CaseStage
  reason    String?
  /// Null for system-triggered transitions (e.g. payment confirmed).
  actorId   String?   @db.Uuid
  actor     User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt DateTime  @default(now())

  @@index([caseId, createdAt])
  @@map("case_transitions")
}

/// Allowed stage graph, per service type — data, not code (see file-header note).
model CaseFlowDefinition {
  id           String      @id @default(uuid()) @db.Uuid
  serviceType  ServiceType
  fromStage    CaseStage
  toStage      CaseStage
  /// Empty = no staff role may trigger this manually (system-only).
  allowedRoles Role[]
  /// True when only `confirmPayment`/other system logic makes this transition.
  isSystemOnly Boolean     @default(false)
  sortOrder    Int         @default(0)

  @@unique([serviceType, fromStage, toStage])
  @@index([serviceType, fromStage])
  @@map("case_flow_definitions")
}

model Contract {
  id     String @id @default(uuid()) @db.Uuid
  caseId String @unique @db.Uuid
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  /// Contract number as it reads on the signed paper — `СГ/26/001`, the
  /// sequence restarting each calendar year.
  number String @unique

  type   ContractType
  status ContractStatus @default(DRAFT)

  // Pricing snapshot taken when the contract is issued (§6.1) — a later price
  // change never rewrites an existing contract.
  totalAmountSnapshot     Decimal        @db.Decimal(14, 2)
  prepaymentModeSnapshot  PrepaymentMode
  prepaymentValueSnapshot Decimal        @db.Decimal(14, 2)
  balanceTriggerSnapshot  BalanceTrigger
  /// Refund conditions, visa-rejection terms, extra-service terms (§5.4) — free-form per template.
  refundPolicy            Json

  /// Fully rendered contract text (template placeholders already substituted).
  bodyMn  String
  pdfPath String?

  sentAt           DateTime?
  acceptedAt       DateTime?
  otpVerifiedAt    DateTime?
  signedAt         DateTime?
  signedIp         String?
  /// Staff-uploaded scan for a PHYSICAL contract (1C-09).
  physicalScanPath String?

  collateralContract CollateralContract?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@map("contracts")
}

/// Real-estate/asset collateral for language-prep visa-stage risk (gksedu.md §5.4) —
/// deliberately thin: the appraisal and collateral terms live in the physical document.
model CollateralContract {
  id         String    @id @default(uuid()) @db.Uuid
  contractId String    @unique @db.Uuid
  contract   Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  isSigned   Boolean   @default(false)
  startDate  DateTime?
  endDate    DateTime?
  filePath   String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("collateral_contracts")
}

/// Admin-editable contract text with `{{placeholder}}` tokens (1C-06).
model ContractTemplate {
  id          String      @id @default(uuid()) @db.Uuid
  serviceType ServiceType
  version     Int         @default(1)
  isActive    Boolean     @default(true)
  bodyMn      String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([serviceType, version])
  @@index([serviceType, isActive])
  @@map("contract_templates")
}

model Payment {
  id     String @id @default(uuid()) @db.Uuid
  caseId String @db.Uuid
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  kind      PaymentKind
  amountMnt Decimal       @db.Decimal(14, 2)
  /// Set for SCHOOL_TUITION payments (§8).
  amountKrw Decimal?      @db.Decimal(14, 2)
  fxRate    Decimal?      @db.Decimal(10, 4)
  status    PaymentStatus @default(PENDING)
  /// How the money reached us. QPAY rows carry a QR; the rest are registered by staff (1C-27).
  method    PaymentMethod @default(QPAY)

  /// Bank transaction number / POS slip number a manual registration was matched against.
  reference String?
  /// Staff note on a manual registration — who handed the cash over, which account, etc.
  note      String?

  qpayInvoiceId String? @unique
  qpayPaymentId String?
  qrText        String?
  qrImage       String?

  paidAt      DateTime?
  receiptPath String?
  dueAt       DateTime?

  /// Set on a REFUND row — the payment it refunds.
  refundOfId String?   @db.Uuid
  refundOf   Payment?  @relation("PaymentRefund", fields: [refundOfId], references: [id], onDelete: SetNull)
  refunds    Payment[] @relation("PaymentRefund")

  createdById String? @db.Uuid
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([caseId])
  @@index([status])
  @@index([method])
  @@map("payments")
}

// ─────────────────────────────────────────────────────────────────────────────
// 1D — Document requirement engine (ARCHITECTURE.md §7, gksedu.md §6).
//
// The list a client must collect is *derived*, never typed by hand: templates
// describe a document, `RequirementRule` rows say under which conditions it is
// needed, and the resolver intersects those rules with one case's conditions.
// Re-running the resolver after a condition changes only *adds* rows — an
// already-submitted document is never deleted (§7.1).
// ─────────────────────────────────────────────────────────────────────────────

/// Which collection round a rule belongs to — school admission (§6) or visa (§10).
enum DocStage {
  ADMISSION
  VISA
}

/// The sponsor's occupation decides which financial papers are required (§6.1).
enum GuarantorType {
  NONE
  EMPLOYEE
  COMPANY_DIRECTOR
  SELF_EMPLOYED
}

/// Who the guarantor is to the applicant. Anything but a parent adds the
/// kinship reference ("төрөл садангийн лавлагаа").
enum GuarantorRelation {
  PARENT
  SIBLING
  UNCLE_AUNT
  OTHER
}

enum Necessity {
  REQUIRED
  CONDITIONAL
  OPTIONAL
}

/// The 12 states of gksedu.md §6.2, in flow order.
enum DocumentStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  UNDER_REVIEW
  NEEDS_FIX
  RESUBMIT_REQUIRED
  ACCEPTED
  IN_TRANSLATION
  TRANSLATED
  CERTIFIED
  READY
  SENT_TO_UNIVERSITY
}

/// What a single document *is* — independent of who needs it (§7.1).
model DocumentTemplate {
  id            String  @id @default(uuid()) @db.Uuid
  /// Stable machine code, e.g. PASSPORT, HS_TRANSCRIPT.
  code          String  @unique
  nameMn        String
  descriptionMn String?
  /// Where to get it: "E-Mongolia-аас".
  sourceHint    String?
  /// Which authority certifies it.
  issuerHint    String?
  /// How long the issued paper stays valid; null = indefinite.
  validityDays  Int?

  needsTranslation      Boolean @default(false)
  needsNotary           Boolean @default(false)
  needsApostille        Boolean @default(false)
  /// "Эх хувиар авчрах" — cannot be closed out online (1D-11).
  needsPhysicalOriginal Boolean @default(false)

  acceptedFileTypes String[] @default(["pdf", "jpg", "png"])
  sampleFilePath    String?
  tipsMn            String?
  isActive          Boolean  @default(true)

  rules         RequirementRule[]
  caseDocuments CaseDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("document_templates")
}

/// One condition → document mapping. Empty array = "applies to all" for that
/// dimension, which keeps the common rules short (§7.1).
model RequirementRule {
  id         String           @id @default(uuid()) @db.Uuid
  templateId String           @db.Uuid
  template   DocumentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  stage              DocStage
  // `@default([])` matters: without it an omitted array is written as SQL NULL,
  // which no `isEmpty` filter matches — and "empty means everyone" is the whole
  // shape of the rule base (§7.1).
  serviceTypes       ServiceType[]       @default([])
  educationLevels    EducationLevel[]    @default([])
  guarantorTypes     GuarantorType[]     @default([])
  guarantorRelations GuarantorRelation[] @default([])
  /// Null = every university; set for a school's extra requirement (1D-18).
  universityId       String?             @db.Uuid
  university         University?         @relation(fields: [universityId], references: [id], onDelete: Cascade)

  necessity     Necessity @default(REQUIRED)
  /// "байгаа тохиолдолд", "манай байгууллагаас шаардсан үед" …
  conditionNote String?
  sortOrder     Int       @default(0)
  isActive      Boolean   @default(true)

  caseDocuments CaseDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stage, isActive])
  @@index([templateId])
  @@index([universityId])
  @@map("requirement_rules")
}

/// The client's answers that drive rule resolution (1D-06). Kept apart from
/// `Client` because a person may run two cases with different sponsors.
model CaseConditions {
  id     String @id @default(uuid()) @db.Uuid
  caseId String @unique @db.Uuid
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  educationLevel    EducationLevel?
  guarantorType     GuarantorType      @default(NONE)
  guarantorRelation GuarantorRelation?
  guarantorName     String?
  guarantorPhone    String?
  note              String?

  answeredById String? @db.Uuid
  answeredBy   User?   @relation(fields: [answeredById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("case_conditions")
}

/// One required document on one case — the row the client actually works on.
model CaseDocument {
  id     String @id @default(uuid()) @db.Uuid
  caseId String @db.Uuid
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  templateId String           @db.Uuid
  template   DocumentTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  /// The rule that produced this row; null once that rule is deleted or when
  /// staff added the document by hand.
  ruleId     String?          @db.Uuid
  rule       RequirementRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  stage         DocStage
  necessity     Necessity      @default(REQUIRED)
  conditionNote String?
  status        DocumentStatus @default(NOT_STARTED)
  sortOrder     Int            @default(0)
  /// Deadline driving the D-7/D-3/D-1 reminders (1D-12).
  dueAt         DateTime?

  submittedAt        DateTime?
  acceptedAt         DateTime?
  readyAt            DateTime?
  sentToUniversityAt DateTime?
  /// Soft delete (ARCHITECTURE.md §9) — a de-required document is hidden, not erased.
  deletedAt          DateTime?

  files     DocumentFile[]
  notes     DocumentReviewNote[]
  workTasks WorkTask[]
  reminders DocumentReminder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([caseId, templateId, stage])
  @@index([caseId, stage])
  @@index([status])
  @@index([dueAt])
  @@map("case_documents")
}

/// A version of an uploaded document (§15.4) — resubmissions keep their history.
model DocumentFile {
  id             String       @id @default(uuid()) @db.Uuid
  caseDocumentId String       @db.Uuid
  caseDocument   CaseDocument @relation(fields: [caseDocumentId], references: [id], onDelete: Cascade)

  version      Int
  /// Storage path — reachable only through a signed token (§9).
  path         String
  originalName String
  sizeBytes    Int
  mimeType     String
  /// The staff-approved final copy (e.g. the certified translation).
  isFinal      Boolean @default(false)

  uploadedById String? @db.Uuid
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  deletedAt DateTime?
  createdAt DateTime  @default(now())

  @@unique([caseDocumentId, version])
  @@index([caseDocumentId])
  @@map("document_files")
}

/// Staff comment attached to a review action (§6.3) — the client reads these to
/// understand what to fix.
model DocumentReviewNote {
  id             String       @id @default(uuid()) @db.Uuid
  caseDocumentId String       @db.Uuid
  caseDocument   CaseDocument @relation(fields: [caseDocumentId], references: [id], onDelete: Cascade)

  authorId String? @db.Uuid
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  body       String
  fromStatus DocumentStatus?
  toStatus   DocumentStatus?
  /// Internal notes stay hidden from the client's checklist.
  isInternal Boolean         @default(false)

  createdAt DateTime @default(now())

  @@index([caseDocumentId, createdAt])
  @@map("document_review_notes")
}

/// Back-office work on a case (§6.4): translation, form filling, essays …
enum WorkTaskType {
  /// 1B-05 — a lead follow-up (call back, meeting, send an offer).
  FOLLOW_UP
  TRANSLATION
  NOTARISATION
  FORM_FILLING
  STUDY_PLAN
  SELF_INTRODUCTION
  SCHOLARSHIP_ESSAY
  COMPLETENESS_CHECK
  FILE_MERGE
  FINAL_REVIEW
  OTHER
}

enum WorkTaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

/// Staff work item. Originally case-scoped (1D-10); 1B-05 added the
/// lead-scoped follow-up, so exactly one of `caseId` / `leadId` is set.
model WorkTask {
  id             String        @id @default(uuid()) @db.Uuid
  caseId         String?       @db.Uuid
  case           Case?         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  leadId         String?       @db.Uuid
  lead           Lead?         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  /// Set when the work is about one document (a translation, typically).
  caseDocumentId String?       @db.Uuid
  caseDocument   CaseDocument? @relation(fields: [caseDocumentId], references: [id], onDelete: Cascade)

  type        WorkTaskType
  title       String
  description String?
  status      WorkTaskStatus @default(TODO)

  assigneeId  String? @db.Uuid
  assignee    User?   @relation("WorkTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById String? @db.Uuid
  createdBy   User?   @relation("WorkTaskCreator", fields: [createdById], references: [id], onDelete: SetNull)

  dueAt       DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([caseId])
  @@index([leadId])
  @@index([assigneeId, status])
  @@index([status, dueAt])
  @@map("work_tasks")
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

/// The single office visit that closes out every "эх хувиар авчрах" document at
/// once (gksedu.md §17.5, 1D-11) — the whole point is that it happens once.
model OfficeAppointment {
  id     String @id @default(uuid()) @db.Uuid
  caseId String @db.Uuid
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  scheduledAt DateTime
  status      AppointmentStatus @default(SCHEDULED)
  note        String?

  createdById String? @db.Uuid
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([caseId])
  @@index([scheduledAt])
  @@map("office_appointments")
}

/// One fired deadline reminder (1D-12). The row *is* the idempotency key —
/// the daily job may run many times a day and still send D-7 once. Actual
/// delivery (email/SMS/in-app) is wired in 1G-02; this records what is due.
model DocumentReminder {
  id             String       @id @default(uuid()) @db.Uuid
  caseDocumentId String       @db.Uuid
  caseDocument   CaseDocument @relation(fields: [caseDocumentId], references: [id], onDelete: Cascade)

  /// 7, 3 or 1 — days before `CaseDocument.dueAt`.
  offsetDays Int
  dueAt      DateTime
  createdAt  DateTime @default(now())

  @@unique([caseDocumentId, offsetDays])
  @@index([createdAt])
  @@map("document_reminders")
}

// ─────────────────────────────────────────────────────────────────────────────
// 1E — Application → school invoice → invitation (gksedu.md §7–§8).
// ─────────────────────────────────────────────────────────────────────────────

/// The 9 states of gksedu.md §7.
enum ApplicationStatus {
  PREPARING
  READY
  SUBMITTED
  UNDER_REVIEW
  ADDITIONAL_DOCS_REQUESTED
  INTERVIEW_SCHEDULED
  ACCEPTED
  REJECTED
  DEFERRED
}

enum ApplicationDecision {
  PASSED
  FAILED
  WAITLISTED
  DEFERRED
}

/// One case's submission to one university. GKS decides in two rounds, regular
/// brokerage in one — the difference lives in `ApplicationResult.round` (§7).
model Application {
  id     String @id @default(uuid()) @db.Uuid
  caseId String @unique @db.Uuid
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  /// Snapshot of the target at submission time; the case may be re-pointed later.
  universityId String?            @db.Uuid
  university   University?        @relation(fields: [universityId], references: [id], onDelete: SetNull)
  programId    String?            @db.Uuid
  program      UniversityProgram? @relation(fields: [programId], references: [id], onDelete: SetNull)
  intakeId     String?            @db.Uuid
  intake       IntakeTerm?        @relation(fields: [intakeId], references: [id], onDelete: SetNull)

  status          ApplicationStatus @default(PREPARING)
  /// The school's own reference for the submission.
  applicationNo   String?
  /// Элсэлтийн хураамж (§7 step 3) — paid to the school, not to GKS.
  admissionFeeKrw Decimal?          @db.Decimal(14, 2)

  submittedAt   DateTime?
  interviewAt   DateTime?
  interviewNote String?
  decidedAt     DateTime?
  note          String?

  results ApplicationResult[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([universityId])
  @@map("applications")
}

model ApplicationResult {
  id            String      @id @default(uuid()) @db.Uuid
  applicationId String      @db.Uuid
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  /// 1 for regular brokerage; GKS also carries a round 2 (§7).
  round     Int                 @default(1)
  decision  ApplicationDecision
  decidedAt DateTime
  note      String?

  recordedById String? @db.Uuid
  recordedBy   User?   @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([applicationId, round])
  @@map("application_results")
}

enum SchoolInvoiceStatus {
  DRAFT
  ISSUED
  PAID
  CONFIRMED_BY_SCHOOL
  CANCELLED
}

/// What the invoice is made of — a school bills tuition, dormitory and
/// insurance on one sheet (§8).
enum InvoiceItemKind {
  TUITION
  DORMITORY
  INSURANCE
  ADMISSION_FEE
  OTHER
}

/// The school's won-denominated bill, plus the MNT figure the client actually
/// transfers and the brokerage's transfer fee (§8).
model SchoolInvoice {
  id     String @id @default(uuid()) @db.Uuid
  caseId String @db.Uuid
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  status SchoolInvoiceStatus @default(DRAFT)

  totalKrw       Decimal @db.Decimal(14, 2)
  /// MNT per 1 KRW, snapshotted when the invoice is issued — a later rate move
  /// never rewrites what the client was told to pay.
  fxRate         Decimal @db.Decimal(12, 6)
  /// `totalKrw × fxRate`, stored so the figure shown to the client is stable.
  amountMnt      Decimal @db.Decimal(14, 2)
  /// Шилжүүлгийн үйлчилгээний шимтгэл (§8) — GKS's own fee, on top.
  transferFeeMnt Decimal @default(0) @db.Decimal(14, 2)

  dueAt              DateTime?
  paidAt             DateTime?
  receiptPath        String?
  /// Set once the school confirms the money landed.
  receivedBySchoolAt DateTime?
  note               String?

  items SchoolInvoiceItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([caseId])
  @@index([status])
  @@map("school_invoices")
}

model SchoolInvoiceItem {
  id        String        @id @default(uuid()) @db.Uuid
  invoiceId String        @db.Uuid
  invoice   SchoolInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  kind      InvoiceItemKind
  labelMn   String
  amountKrw Decimal         @db.Decimal(14, 2)
  sortOrder Int             @default(0)

  @@index([invoiceId])
  @@map("school_invoice_items")
}

/// The letter that ends the admission phase and opens the visa one (§8).
model Invitation {
  id     String @id @default(uuid()) @db.Uuid
  caseId String @unique @db.Uuid
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  number     String?
  issuedAt   DateTime?
  receivedAt DateTime  @default(now())
  filePath   String?
  note       String?

  uploadedById String? @db.Uuid
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("invitations")
}

/// Daily Mongolbank reference rate (1E-07). One row per currency per day; the
/// invoice snapshots the value rather than joining on it.
model FxRate {
  id       String   @id @default(uuid()) @db.Uuid
  currency String   @default("KRW")
  /// MNT per 1 unit of `currency`.
  rate     Decimal  @db.Decimal(12, 6)
  date     DateTime @db.Date
  source   String   @default("mongolbank")

  createdAt DateTime @default(now())

  @@unique([currency, date])
  @@index([currency, date])
  @@map("fx_rates")
}

// ─────────────────────────────────────────────────────────────────────────────
// 1F — Visa and pre-departure (gksedu.md §10–§11).
// ─────────────────────────────────────────────────────────────────────────────

/// The 8 states of gksedu.md §10.
enum VisaStatus {
  COLLECTING
  REVIEWING
  READY
  SUBMITTED
  ADDITIONAL_DOCS_REQUESTED
  APPROVED
  REJECTED
  REAPPLY
}

enum VisaType {
  /// Degree study.
  D2
  /// Language training.
  D4
  OTHER
}

/// The client applies in person; GKS prepares every paper behind it (§10).
model VisaCase {
  id     String @id @default(uuid()) @db.Uuid
  caseId String @unique @db.Uuid
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  status   VisaStatus @default(COLLECTING)
  visaType VisaType

  /// Consulate appointment (§10 "цаг захиалах").
  appointmentAt   DateTime?
  submittedAt     DateTime?
  decidedAt       DateTime?
  visaNumber      String?
  expiresAt       DateTime?
  rejectionReason String?
  note            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("visa_cases")
}

/// Reusable checklist row seeded from §11 and cloned into every plan (1F-07).
model DepartureChecklistTemplate {
  code          String  @id
  titleMn       String
  descriptionMn String?
  guideUrl      String?
  videoUrl      String?
  /// How many days before departure this should be done; drives `dueAt`.
  offsetDays    Int?
  sortOrder     Int     @default(0)
  isActive      Boolean @default(true)

  items DepartureChecklistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("departure_checklist_templates")
}

model DeparturePlan {
  id     String @id @default(uuid()) @db.Uuid
  caseId String @unique @db.Uuid
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  departureAt     DateTime?
  flightNo        String?
  arrivalAt       DateTime?
  /// Сургуулийн тосох үйлчилгээ (§11).
  pickupRequested Boolean   @default(false)
  dormitoryInfo   String?
  emergencyNote   String?
  note            String?

  items DepartureChecklistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("departure_plans")
}

model DepartureChecklistItem {
  id     String        @id @default(uuid()) @db.Uuid
  planId String        @db.Uuid
  plan   DeparturePlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  /// Null once the seed row it came from is retired, or for a hand-added item.
  templateCode String?                     @db.VarChar(64)
  template     DepartureChecklistTemplate? @relation(fields: [templateCode], references: [code], onDelete: SetNull)

  titleMn       String
  descriptionMn String?
  guideUrl      String?
  videoUrl      String?
  dueAt         DateTime?
  isDone        Boolean   @default(false)
  doneAt        DateTime?
  sortOrder     Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([planId, templateCode])
  @@index([planId])
  @@map("departure_checklist_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// Audit trail — 0-11 (ARCHITECTURE.md §11: "Бүх мэдрэмтгий үйлдэл AuditLog-д").
//
// One row per sensitive write: who, what, when, before/after. Written by
// `AuditInterceptor` from the `@Audit()` decorator, so a route opts in rather
// than every read flooding the table.
// ─────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  /// Null for system-generated actions (scheduled jobs, QPay callbacks).
  actorId    String? @db.Uuid
  actor      User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  /// Snapshot — the log must still read correctly after the user row is gone.
  actorLabel String? @db.VarChar(160)

  /// Dotted action name, e.g. `case.transition`, `contract.confirm`.
  action   String  @db.VarChar(80)
  /// Prisma model name the action targets, e.g. `Case`.
  entity   String  @db.VarChar(60)
  entityId String? @db.Uuid

  before Json?
  after  Json?

  ip        String? @db.VarChar(64)
  requestId String? @db.VarChar(64)

  createdAt DateTime @default(now())

  @@index([entity, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// 1G — Notifications (gksedu.md §16, ARCHITECTURE.md §10).
//
// An event fires → the dispatcher looks up every active template for that
// event → one `Notification` row per channel → the queue delivers it.
// In-app is always produced; email/SMS only exist when a template for that
// channel exists *and* the recipient has not switched the channel off.
// ─────────────────────────────────────────────────────────────────────────────

/// The 16 automatic notifications of gksedu.md §16, plus the two staff-side
/// triggers the office needs (`LEAD_CREATED` completes 1A-17).
enum NotificationEvent {
  // Account lifecycle
  ACCOUNT_CREATED
  // Materials (§6)
  DOCUMENT_DEADLINE_NEAR
  DOCUMENT_MISSING
  DOCUMENT_REJECTED
  DOCUMENT_FIX_REQUIRED
  DOCUMENT_APPROVED
  // Contract & payment (§5)
  CONTRACT_CONFIRMED
  PAYMENT_DUE
  PAYMENT_CONFIRMED
  // Application (§7)
  APPLICATION_RESULT
  APPLICATION_EXTRA_DOCS
  INVITATION_RECEIVED
  // Visa (§8)
  VISA_STAGE_STARTED
  VISA_APPOINTMENT_DUE
  VISA_RESULT
  VISA_RENEWAL_NEAR
  // Departure (§10)
  DEPARTURE_NEAR
  FLIGHT_INFO_UPDATED
  // Admissions (§4.1, §4.2) — the intake calendar
  /// To the client: our registration deadline for their intake is closing in.
  INTAKE_DEADLINE_NEAR
  /// To a saved-university follower: a new round opened at a school they starred.
  INTAKE_OPENED
  // Staff-side
  LEAD_CREATED
  LEAD_FOLLOW_UP_DUE
  /// To the assigned consultant and document officer: this case will miss its
  /// intake unless someone moves. The answer to "ажилтан хэрэглэгчээ мартах".
  INTAKE_CASE_AT_RISK
  // Messenger (1K)
  /// To the client: a consultant answered a thread they are not currently
  /// watching. Raised only when the reader is away — the live thread already
  /// shows the message, and a bell for something on screen is noise.
  SUPPORT_REPLY
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  /// Reserved — no provider wired yet (ARCHITECTURE.md §10 "дараа нь push").
  PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  /// Recipient turned the channel off, or has no address for it.
  SKIPPED
}

/// Mongolian body text per event × channel. Editable by ADMIN (1G-06).
model NotificationTemplate {
  id String @id @default(uuid()) @db.Uuid

  event   NotificationEvent
  channel NotificationChannel

  /// `{{placeholder}}` interpolation against the dispatcher's context.
  titleMn String  @db.VarChar(200)
  bodyMn  String
  /// In-app/email deep link, e.g. `/app/cases/{{caseId}}/documents`.
  linkMn  String? @db.VarChar(300)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notifications Notification[]

  @@unique([event, channel])
  @@map("notification_templates")
}

/// One delivery of one event to one recipient over one channel.
model Notification {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  event   NotificationEvent
  channel NotificationChannel

  templateId String?               @db.Uuid
  template   NotificationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  /// Rendered at dispatch time — editing a template never rewrites history.
  title String  @db.VarChar(200)
  body  String
  link  String? @db.VarChar(300)

  /// Context the templates interpolated; also what the UI groups by.
  caseId String? @db.Uuid
  case   Case?   @relation(fields: [caseId], references: [id], onDelete: SetNull)
  leadId String? @db.Uuid
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)
  meta   Json    @default("{}")

  status       NotificationStatus @default(PENDING)
  sentAt       DateTime?
  readAt       DateTime?
  failedReason String?
  attempts     Int                @default(0)

  /// Idempotency for scheduled sweeps: `event:channel:userId:subject`.
  /// A daily job may run many times and still notify once.
  dedupeKey String? @unique @db.VarChar(200)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, readAt, createdAt])
  @@index([status, channel])
  @@index([event, createdAt])
  @@index([createdAt])
  @@map("notifications")
}

/// Per-user channel switches. A missing row means "on"; in-app can never be
/// switched off, so it is never stored.
model NotificationPreference {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  channel NotificationChannel
  enabled Boolean             @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, channel])
  @@map("notification_preferences")
}

/// 1G-14 — a dated promo strip on the public site (an intake deadline, a new
/// scholarship round). Deliberately minimal: one line of text, one link, a
/// window. Anything longer is a `Post`.
enum BannerPlacement {
  /// Full-width strip above the site header.
  SITE_TOP
  /// Card slot on the landing page, under the hero.
  HOME_HERO
}

model Banner {
  id String @id @default(uuid()) @db.Uuid

  placement BannerPlacement @default(SITE_TOP)
  titleMn   String          @db.VarChar(160)
  bodyMn    String?         @db.VarChar(400)
  linkUrl   String?         @db.VarChar(300)
  linkLabel String?         @db.VarChar(60)

  /// Null on either side means "open-ended".
  startsAt DateTime?
  endsAt   DateTime?

  isPublished Boolean @default(false)
  sortOrder   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([placement, isPublished, sortOrder])
  @@map("banners")
}

// ─────────────────────────────────────────────────────────────────────────────
// Messenger (1K) — the client writes to a real consultant, not to a bot.
//
// A shared inbox, not a per-consultant queue: a question arrives before anyone
// is assigned to the person asking it (a brand-new account has no contract, no
// case and no consultant), so the thread lands in one room every staff member
// can see and any of them can claim. `assigneeId` is the claim, and it is
// nullable for exactly as long as nobody has taken it.
//
// Deliberately not the AI assistant of `gksedu.md` §13 — that one gets its own
// `ChatSession`/`ChatMessage` in phase 2 and answers from the knowledge base.
// This is human-to-human, and the two must never share a thread table.
// ─────────────────────────────────────────────────────────────────────────────

enum ConversationStatus {
  /// Live: somebody still owes somebody an answer.
  OPEN
  /// Staff closed it. The client can reopen by writing again.
  RESOLVED
}

/// What the client says the thread is about, picked when they open it. Drives
/// the inbox filter and nothing else — it is a hint, never a routing rule.
enum ConversationTopic {
  GENERAL
  /// Сургууль сонголт, элсэлтийн хугацаа.
  ADMISSION
  /// Материал, бичиг баримт.
  DOCUMENTS
  /// Гэрээ, төлбөр.
  CONTRACT
  VISA
  /// Явахын өмнөх бэлтгэл.
  DEPARTURE
  OTHER
}

model Conversation {
  id   String @id @default(uuid()) @db.Uuid
  /// Human-readable, e.g. CH-2026-0042 — what the office quotes on the phone.
  code String @unique

  /// The person who opened it. Always the client side of the thread: staff
  /// never start a conversation with themselves, so this is not nullable.
  clientUserId String @db.Uuid
  clientUser   User   @relation("ConversationClient", fields: [clientUserId], references: [id], onDelete: Cascade)

  /// Set when the question is about one service cycle, which lets the CRM show
  /// the thread inside that case. A general enquiry has no case and never will.
  caseId String? @db.Uuid
  case   Case?   @relation(fields: [caseId], references: [id], onDelete: SetNull)

  subject String             @db.VarChar(160)
  topic   ConversationTopic  @default(GENERAL)
  status  ConversationStatus @default(OPEN)

  /// The claim. Null means "in the shared inbox, nobody has taken it" — the
  /// state the inbox sorts to the top.
  assigneeId String?   @db.Uuid
  assignee   User?     @relation("ConversationAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assignedAt DateTime?

  // ── Denormalised thread head. The inbox and the client's thread list both
  //    sort by last activity and show the last line; recomputing that from
  //    `messages` would join the largest table in the schema on every open.
  lastMessageAt        DateTime @default(now())
  lastMessagePreview   String?  @db.VarChar(200)
  /// Which side spoke last — the inbox's "waiting on us" filter.
  lastMessageFromStaff Boolean  @default(false)

  /// Unread counts per side, maintained on write. Staff share one count
  /// because they share the inbox: what one of them reads, all of them have.
  clientUnread Int @default(0)
  staffUnread  Int @default(0)

  clientReadAt DateTime?
  staffReadAt  DateTime?

  /// First staff reply — the only response-time number worth reporting on.
  firstResponseAt DateTime?

  resolvedAt   DateTime?
  resolvedById String?   @db.Uuid
  resolvedBy   User?     @relation("ConversationResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]

  /// The inbox's default order, and its "unassigned first" view.
  @@index([status, lastMessageAt])
  @@index([assigneeId, status, lastMessageAt])
  @@index([clientUserId, lastMessageAt])
  @@index([caseId])
  @@map("conversations")
}

enum MessageKind {
  TEXT
  /// A line the system wrote: claimed, resolved, reopened. Rendered centred
  /// and greyed, never as somebody's bubble.
  SYSTEM
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  /// Null for a SYSTEM line, which nobody wrote.
  senderId String? @db.Uuid
  sender   User?   @relation(fields: [senderId], references: [id], onDelete: SetNull)

  /// Which side of the thread this came from, frozen at write time. A
  /// consultant who later becomes an admin — or a staff account that is
  /// demoted — must not move their old bubbles across the thread.
  fromStaff Boolean @default(false)

  kind MessageKind @default(TEXT)
  body String      @db.VarChar(4000)

  /// The sender's own id for this send, so a retried request after a dropped
  /// connection reuses the row instead of posting the line twice.
  clientToken String? @db.VarChar(64)

  editedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([conversationId, clientToken])
  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("messages")
}
